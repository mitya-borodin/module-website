---
import '../styles/global.css';
import MobileGesturePolicy from '../components/mobile-gesture-policy.astro';
import { mobileViewport } from '../data/mobile-viewport';
import SocialImageMeta from '../components/social-image-meta.astro';
import cabinetPreview from '../assets/social/home-v1.jpg';
import softwarePreview from '../assets/social/software-v1.jpg';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const isSoftwarePage = Astro.url.pathname === '/software/';
const previewImage = isSoftwarePage ? softwarePreview : cabinetPreview;
const previewAlt = isSoftwarePage
  ? 'Дом с управляемым освещением, шторами, климатом и водоснабжением — возможности ПО Ritmod.'
  : 'Собранный щит автоматизации с контроллером и модулями Wiren Board для работы Ritmod.';
const navigation = isSoftwarePage ? [
  { href: '#operation', label: 'Как работает' },
  { href: '#automations', label: 'Автоматизации' },
  { href: '#management', label: 'Управление' },
  { href: '#purchase', label: 'Как приобрести' },
] : [
  { href: '/#result', label: 'Состав комплекта' },
  { href: '/#process', label: 'Как работаем' },
  { href: '/#solutions', label: 'Задачи объекта' },
  { href: '/#contacts', label: 'Контакты' },
  { href: '/software/', label: 'ПО Ritmod' },
];
const contactHref = isSoftwarePage ? '#software-contact' : '/#contacts';
const contactLabel = isSoftwarePage ? 'Обсудить ПО' : 'Обсудить проект';
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content={mobileViewport} />
    <MobileGesturePolicy />
    <meta name="description" content={description} />
    <meta name="robots" content="noindex,nofollow" />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Ritmod" />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <SocialImageMeta image={previewImage} alt={previewAlt} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Перейти к содержанию</a>
    <header class:list={['site-header', { 'site-header--software': isSoftwarePage }]}>
      <div class="shell header-inner">
        <a class="brand" href="/" aria-label="Ritmod — главная">
          <span class="brand-mark" aria-hidden="true">R</span>
          <span>Ritmod</span>
          {isSoftwarePage && <span class="brand-product">ПО</span>}
        </a>
        <nav class="desktop-nav" aria-label="Основная навигация">
          {navigation.map(({ href, label }) => (
            <a href={href} aria-current={href === '/software/' && isSoftwarePage ? 'page' : undefined}>
              {label}
            </a>
          ))}
          <a href="/ru/docs/">Документация</a>
        </nav>
        <a class="header-cta" href={contactHref}>{contactLabel} <span aria-hidden="true">↗</span></a>
        <details class="mobile-nav">
          <summary>Меню</summary>
          <nav aria-label="Мобильная навигация">
            {navigation.map(({ href, label }) => (
              <a href={href} aria-current={href === '/software/' && isSoftwarePage ? 'page' : undefined}>
                {label}
              </a>
            ))}
            <a href="/ru/docs/">Документация</a>
            {isSoftwarePage && <a href="/#result">Проектирование и сборка щита ↗</a>}
            <a href={contactHref}>{contactLabel} ↗</a>
          </nav>
        </details>
      </div>
    </header>

    <main id="main" tabindex="-1"><slot /></main>

    <footer class="site-footer">
      <div class="shell footer-grid">
        <a class="brand brand--footer" href="/"><span class="brand-mark" aria-hidden="true">R</span>Ritmod</a>
        <p>{isSoftwarePage ? 'ПО Ritmod · Готовые автоматизации · Управление из браузера' : 'Проект · Собранный щит · Подготовленные автоматизации · Документация'}</p>
        <nav aria-label="Навигация в подвале">
          <a href={isSoftwarePage ? '/#result' : '/software/'}>{isSoftwarePage ? 'Проектирование и сборка' : 'ПО Ritmod'}</a>
          <a href="/ru/docs/">Документация</a>
        </nav>
      </div>
    </footer>

    <script>
      document.querySelectorAll<HTMLDetailsElement>('.mobile-nav').forEach((menu) => {
        menu.querySelectorAll<HTMLAnchorElement>('a').forEach((link) => {
          link.addEventListener('click', () => {
            menu.open = false;
          });
        });

        menu.addEventListener('keydown', (event) => {
          if (event.key === 'Escape') {
            menu.open = false;
            menu.querySelector('summary')?.focus();
          }
        });
      });
    </script>
  </body>
</html>

<style>
  .site-header--software {
    --paper: #171814;
    --line: #ffffff29;
    --accent-dark: var(--signal);
    color: var(--paper-strong);
  }

  .site-header--software .brand-mark {
    color: var(--ink);
    background: var(--signal);
  }

  .brand-product {
    padding: 5px 7px;
    border: 1px solid #d9f99d4d;
    border-radius: 5px;
    color: var(--signal);
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: .04em;
  }

  .site-header--software .mobile-nav[open] nav {
    background: var(--paper);
    box-shadow: 0 12px 30px #00000040;
  }

  .site-header--software .mobile-nav nav a:last-child {
    color: var(--ink);
    background: var(--signal);
  }
</style>
