---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import '../styles/automation-scene.css';

const icons = {
  lighting: 'M9 18h6M10 21h4M8.5 14.5a6 6 0 1 1 7 0L15 18H9l-.5-3.5Z',
  curtains: 'M3 3h18M4 3v18h16V3M9 3v9l-5 3M15 3v9l5 3M9 12v9M15 12v9',
  climate: 'M9 14.5V5a3 3 0 0 1 6 0v9.5a5 5 0 1 1-6 0ZM12 8v10',
  water: 'M12 2S5 10 5 15a7 7 0 0 0 14 0c0-5-7-13-7-13ZM9 16l2 2 4-5',
};

type SceneScenario = {
  title: string;
  shortTitle?: string;
  detail: string;
  href: string;
  icon: keyof typeof icons;

  position: { left?: number; right?: number; top: number };
};

type Props = {
  image: ImageMetadata;
  alt: string;
  sizes?: string;
  compact?: boolean;
  eager?: boolean;
  caption: string;
  legendLabel: string;
  operationHref: string;

  scenarios: readonly SceneScenario[];
};

const { image, alt, sizes = '(max-width: 850px) 94vw, 58vw', compact = false, eager = true,
  caption, legendLabel, operationHref, scenarios } = Astro.props;
---

<figure class:list={['overview-visual spatial-scene', { 'spatial-scene--compact': compact }]}>
  <div class="spatial-frame">
    <Image src={image} alt={alt} widths={[480, 768, 1024, 1536]}
      sizes={sizes} format="webp" loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : 'auto'} />
    <slot name="effects" />
    {scenarios.length > 0 && <nav class="spatial-callouts" aria-label={legendLabel}>
      {scenarios.map((scenario) => (
        <a class="spatial-callout" href={scenario.href} aria-label={compact ? scenario.title : undefined}
          style={`--callout-left: ${scenario.position.left === undefined ? 'auto' : `${scenario.position.left}%`}; --callout-right: ${scenario.position.right === undefined ? 'auto' : `${scenario.position.right}%`}; --callout-top: ${scenario.position.top}%;`}>
          <svg class="callout-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor"
            stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d={icons[scenario.icon]} />
          </svg>
          <span><strong>{compact ? scenario.shortTitle ?? scenario.title : scenario.title}</strong>{!compact && <small>{scenario.detail}</small>}</span>
          {!compact && <span class="callout-arrow" aria-hidden="true">↗</span>}
        </a>
      ))}
    </nav>}
  </div>
  {!compact && <figcaption>
    <a class="spatial-signature" href={operationHref}><span aria-hidden="true">R</span> Автоматизации Ritmod <span aria-hidden="true">↗</span></a>
    <span class="spatial-caption">{caption}</span>
  </figcaption>}
</figure>
