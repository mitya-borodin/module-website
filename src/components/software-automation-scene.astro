---
import AutomationScene from './automation-scene.astro';
import softwareHouse from '../assets/site/software-home-interior-v1.png';

const scenarios = [
  {
    title: 'Свет там, где он нужен',
    detail: 'По движению и вашим условиям',
    href: '/ru/docs/automations/lighting/',
    icon: 'lighting',
    position: { left: 30, top: 52 },
  },
  {
    title: 'Шторы учитывают солнце',
    detail: 'Свет и солнечные фазы',
    href: '/ru/docs/automations/curtains/',
    icon: 'curtains',
    position: { left: 3, top: 18 },
  },
  {
    title: 'Температура поддерживается',
    detail: 'Отопление и охлаждение',
    href: '/ru/docs/automations/heating/',
    icon: 'climate',
    position: { right: 6, top: 6 },
  },
  {
    title: 'Защита от протечек',
    detail: 'Команда перекрыть воду по сигналу',
    href: '/ru/docs/automations/leaks/',
    icon: 'water',
    position: { right: 3, top: 75 },
  },
] as const;
---

<AutomationScene image={softwareHouse} sizes="(min-width: 1440px) 786px, (min-width: 1101px) 56vw, 94vw"
  alt="Вид изнутри дома: гостиная со шторами и радиатором, освещённая кухня, кондиционер и техническая ниша с краном управления водой. Отметки показывают автоматизации каждой зоны."
  caption="Датчики передают показания. Ritmod управляет системами дома."
  legendLabel="Автоматизации в доме" operationHref="#operation" scenarios={scenarios}>
  <svg slot="effects" class="spatial-effects" viewBox="0 0 1536 1024" fill="none" aria-hidden="true">
    <g>
      <ellipse class="spatial-outline" cx="635" cy="292" rx="40" ry="12" />
      <path class="spatial-outline" d="m174 56 159 49M191 74v345" />
      <path class="curtain-flow" d="m226 215 58 18m-13-14 13 14-19 3" />
    </g>
    <g style="--scene-glow: #d4eee6;">
      <path class="spatial-outline" d="m960 128 176-21v65l-176 23Z" />
      <path class="heat-flow" d="M1001 200q-8 20 0 34m30-40q-8 20 0 34m30-41q-8 20 0 34" />
      <path class="spatial-outline" d="M1380 313h46v30h-46Z" />
    </g>
    <g class="spatial-leaders">
      <path d="M635 292v280" />
      <path d="M234 77v152H133" />
      <path d="M1049 151V109h144" />
      <path d="M1405 330v489" />
    </g>
    <g class="spatial-nodes">
      <circle cx="635" cy="292" r="13" />
      <circle cx="234" cy="77" r="13" />
      <circle cx="1049" cy="151" r="13" />
      <circle cx="1405" cy="330" r="13" />
    </g>
    <g class="spatial-node-cores">
      <circle cx="635" cy="292" r="4" />
      <circle cx="234" cy="77" r="4" />
      <circle cx="1049" cy="151" r="4" />
      <circle cx="1405" cy="330" r="4" />
    </g>
  </svg>
</AutomationScene>

