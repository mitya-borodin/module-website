---
import type { ImageMetadata } from 'astro';

interface Props {
  desktop: ImageMetadata;
  mobile: ImageMetadata;
  alt: string;
  caption: string;
}

const { desktop, mobile, alt, caption } = Astro.props;
---

<figure class="docs-screenshot" style={`--desktop-width: ${desktop.width}px; --mobile-width: ${mobile.width}px;`}>
  <picture>
    <source
      media="(max-width: 50rem)"
      srcset={mobile.src}
      width={mobile.width}
      height={mobile.height}
    />
    <img
      src={desktop.src}
      width={desktop.width}
      height={desktop.height}
      alt={alt}
      loading="lazy"
      decoding="async"
    />
  </picture>
  <figcaption>
    <span>{caption}</span>
    <a class="desktop-link" href={desktop.src} target="_blank" rel="noopener noreferrer" aria-label={`${caption} — открыть крупнее в новой вкладке`}>
      Открыть крупнее ↗
    </a>
    <a class="mobile-link" href={mobile.src} target="_blank" rel="noopener noreferrer" aria-label={`${caption} — открыть крупнее в новой вкладке`}>
      Открыть крупнее ↗
    </a>
  </figcaption>
</figure>

<style>
  .docs-screenshot {
    width: 100%;
    max-width: var(--desktop-width);
    margin: 1.5rem 0 2rem;
  }

  picture {
    display: block;
    overflow: hidden;
    border: 1px solid var(--sl-color-gray-4);
    border-radius: 0.5rem;
    background: #fff;
  }

  img {
    display: block;
    width: 100%;
    height: auto;
    margin: 0;
  }

  figcaption {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 1rem;
    margin-top: 0.5rem;
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--sl-color-gray-2);
  }

  figcaption > * {
    margin: 0;
  }

  a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    text-underline-offset: 0.2em;
  }

  a:focus-visible {
    outline: 2px solid var(--sl-color-accent-high);
    outline-offset: 4px;
  }

  .mobile-link {
    display: none;
  }

  @media (max-width: 50rem) {
    .docs-screenshot {
      max-width: var(--mobile-width);
    }

    .desktop-link {
      display: none;
    }

    .mobile-link {
      display: inline-flex;
    }
  }
</style>
