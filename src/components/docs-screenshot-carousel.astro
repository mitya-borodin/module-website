---
import type { ImageMetadata } from 'astro';

interface Frame {
  key: string;
  title: string;
  image: ImageMetadata;
}

interface Props {
  id: string;
  guide: Record<'mobile' | 'tablet' | 'desktop', Frame[]>;
  caption: string;
}

const { id, guide, caption } = Astro.props;
const views = [
  { key: 'mobile', name: 'Телефон' },
  { key: 'tablet', name: 'Планшет' },
  { key: 'desktop', name: 'Компьютер' },
] as const;
---

<figure class="screenshot-carousel" data-screenshot-carousel data-view="auto" aria-label={caption}>
  <div class="screenshot-frame">
    <div class="carousel-controls">
      <div class="view-controls" hidden>
        <div role="tablist" aria-label={`Вид экрана: ${caption}`}>
          {views.map(({ key, name }) => (
            <button type="button" role="tab" id={`${id}-${key}-tab`}
              aria-controls={`${id}-${key}`} aria-selected="false" tabindex="-1"
              data-view-tab={key}>{name}</button>
          ))}
        </div>
      </div>
    </div>
    <div class="screens">
      {views.map(({ key, name }) => (
        <div class="screen" id={`${id}-${key}`} data-screen={key} role="tabpanel"
          aria-labelledby={`${id}-${key}-tab`}>
          {guide[key].map((frame, index) => (
            <div class:list={['action-frame', { 'action-frame--wide': frame.image.width > frame.image.height * 1.8 }]}
              data-action-key={frame.key}>
              <p class="action-title">
                <span class="action-number">{index + 1}</span>
                <span>{frame.title}</span>
              </p>
              <a class="image-link" href={frame.image.src} target="_blank" rel="noopener noreferrer"
                aria-label={`${name}: ${frame.title} — открыть крупнее`}>
                <img src={frame.image.src} width={frame.image.width} height={frame.image.height}
                  alt={`${name}. ${frame.title}`} loading="lazy" decoding="async" />
              </a>
              <a class="enlarge" href={frame.image.src} target="_blank" rel="noopener noreferrer">Открыть крупнее ↗</a>
            </div>
          ))}
        </div>
      ))}
    </div>
  </div>
  <figcaption>{caption}</figcaption>
  <noscript>
    <details><summary>Все кадры этого шага</summary>
      {views.map(({ key, name }) => (
        <div><p>{name}</p><ol>{guide[key].map((frame) => <li><a href={frame.image.src}>{frame.title}</a></li>)}</ol></div>
      ))}
    </details>
  </noscript>
</figure>

<script>
  function initializeScreenshots() {
    const roots = Array.from(document.querySelectorAll<HTMLElement>('[data-screenshot-carousel]:not([data-ready])'));
    if (!roots.length) {
      return;
    }

    const lifecycle = new AbortController();
    document.addEventListener('astro:before-swap', () => lifecycle.abort(), { once: true });
    const renderViews: Array<(index: number) => void> = [];
    let activeView = window.innerWidth <= 600 ? 0 : window.innerWidth <= 1100 ? 1 : 2;

    /** Вид GUI общий для страницы; место переключателя сохраняется при смене длины шагов. */
    const selectView = (index: number, controls: HTMLElement) => {
      const previousTop = controls.getBoundingClientRect().top;
      activeView = (index + 3) % 3;
      renderViews.forEach((render) => render(activeView));
      window.scrollBy(0, controls.getBoundingClientRect().top - previousTop);
      controls.scrollIntoView({ block: 'nearest', inline: 'nearest' });
    };

    roots.forEach((root) => {
      const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-view-tab]'));
      const screens = Array.from(root.querySelectorAll<HTMLElement>('[data-screen]'));
      const viewControls = root.querySelector<HTMLElement>('.view-controls');
      if (!viewControls) {
        return;
      }

      root.dataset.ready = 'true';
      viewControls.hidden = false;

      const renderView = (index: number) => {
        root.dataset.view = tabs[index].dataset.viewTab;
        tabs.forEach((tab, i) => {
          tab.setAttribute('aria-selected', String(i === index));
          tab.tabIndex = i === index ? 0 : -1;
          screens[i].hidden = i !== index;
        });
      };

      renderViews.push(renderView);
      renderView(activeView);

      /** Меняется только число колонок: все действия остаются в потоке страницы. */
      const updateLayout = () => {
        const gridMode = window.innerHeight >= 560 && root.getBoundingClientRect().width >= 600;
        root.dataset.layout = gridMode ? 'grid' : 'stack';
      };

      const observer = new ResizeObserver(updateLayout);
      observer.observe(root);
      lifecycle.signal.addEventListener('abort', () => observer.disconnect(), { once: true });
      window.addEventListener('resize', updateLayout, { signal: lifecycle.signal });
      updateLayout();

      tabs.forEach((tab, index) => {
        tab.addEventListener('click', () => selectView(index, viewControls));
        tab.addEventListener('keydown', (event) => {
          const nextView = event.key === 'ArrowRight' ? activeView + 1 : event.key === 'ArrowLeft' ? activeView - 1 : event.key === 'Home' ? 0 : event.key === 'End' ? tabs.length - 1 : null;
          if (nextView === null) {
            return;
          }

          event.preventDefault();
          selectView(nextView, viewControls);
          tabs[activeView].focus({ preventScroll: true });
        });
      });
    });
  }

  initializeScreenshots();
  document.addEventListener('astro:page-load', initializeScreenshots);
</script>

<style>
  .screenshot-carousel {
    margin: 1.2rem 0 2.5rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: .8rem;
    overflow: hidden;
  }
  .screenshot-carousel :global(*) {
    margin-block: 0;
  }
  .screenshot-frame {
    min-width: 0;
  }
  .carousel-controls {
    display: flex;
    background: var(--sl-color-bg-sidebar);
  }
  .view-controls {
    display: flex;
    flex: 1 1 auto;
    align-items: center;
    padding: .5rem;
  }
  [hidden] {
    /* Скрывается только невыбранный вид GUI, а не отдельные действия. */
    display: none !important;
  }
  [role='tablist'] {
    display: flex;
    flex: 1;
    justify-content: center;
    min-width: 0;
  }
  button {
    font: inherit;
    font-size: .8rem;
    border: 0;
    border-radius: .4rem;
    background: transparent;
    color: var(--sl-color-text);
    min-height: 2.75rem;
    padding: .4rem .7rem;
    cursor: pointer;
  }
  button[aria-selected='true'] {
    background: var(--sl-color-accent-low);
    color: var(--sl-color-accent-high);
    font-weight: 650;
  }
  button:focus-visible, a:focus-visible {
    outline: 3px solid var(--sl-color-accent-high);
    outline-offset: -3px;
  }
  .screens {
    min-width: 0;
    background: var(--sl-color-bg-sidebar);
  }
  .screen {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1rem;
    min-width: 0;
    padding: .75rem;
  }
  .action-frame {
    /* Весь пункт, включая подпись и увеличение, занимает 85% свободной высоты.
       svh учитывает раскрытые панели браузера и не растягивает кадр при прокрутке. */
    display: grid;
    grid-template-rows: auto minmax(0, 1fr) auto;
    height: min(44.2rem, calc((100vh - var(--sl-nav-height) - var(--sl-mobile-toc-height, 0px) - 3rem) * .85));
    height: min(44.2rem, calc((100svh - var(--sl-nav-height) - var(--sl-mobile-toc-height, 0px) - 3rem) * .85));
    min-width: 0;
    min-height: 0;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: .65rem;
    background: var(--sl-color-bg);
    overflow: hidden;
    /* Отступ под шапку уже задан scroll-padding страницы Starlight. */
    scroll-margin-top: .5rem;
    scroll-margin-bottom: 1rem;
  }
  .action-title {
    display: flex;
    align-items: flex-start;
    gap: .6rem;
    padding: .8rem .8rem 0;
    color: var(--sl-color-text);
    font-weight: 650;
    font-size: .95rem;
    line-height: 1.45;
    text-align: start;
  }
  .action-number {
    display: inline-flex;
    flex: 0 0 1.6rem;
    align-items: center;
    justify-content: center;
    height: 1.6rem;
    border-radius: 50%;
    background: var(--sl-color-accent-low);
    color: var(--sl-color-accent-high);
    font-size: .8rem;
    font-variant-numeric: tabular-nums;
  }
  .image-link {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: .75rem;
    min-width: 0;
    min-height: 0;
    overflow: hidden;
  }
  img {
    display: block;
    max-width: 100%;
    width: 100%;
    height: 100%;
    min-height: 0;
    max-height: 100%;
    object-fit: contain;
    background: white;
    box-shadow: 0 1px 6px #0001;
  }
  .enlarge {
    display: inline-flex;
    align-items: center;
    justify-self: center;
    min-height: 2.75rem;
    font-size: .85rem;
    color: var(--sl-color-text-accent);
  }
  [data-layout='grid'] .view-controls {
    flex: 0 1 auto;
  }
  [data-layout='grid'] .screen {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    padding: 1rem;
  }
  [data-layout='grid'] .action-frame {
    grid-template-rows: auto auto auto;
    align-content: start;
    height: auto;
  }
  [data-layout='grid'] .action-frame--wide {
    grid-column: 1 / -1;
  }
  [data-layout='grid'] .action-title {
    padding: .85rem .85rem 0;
    font-size: .875rem;
    line-height: 1.5;
  }
  [data-layout='grid'] .image-link {
    align-items: flex-start;
    padding: .75rem;
  }
  [data-layout='grid'] img {
    width: auto;
    height: auto;
    max-height: min(32rem, calc(100vh - var(--sl-nav-height) - 10rem));
    border-radius: .3rem;
  }
  figcaption {
    padding: .8rem 1rem;
    font-size: .9rem;
    line-height: 1.55;
  }
  [data-view='auto'] .screen:not([data-screen='desktop']) {
    display: none;
  }
  @media (max-width: 1100px) and (min-width: 601px) {
    [data-view='auto'] .screen {
      display: none;
    }
    [data-view='auto'] .screen[data-screen='tablet'] {
      display: grid;
    }
  }
  @media (max-width: 600px) {
    [data-view='auto'] .screen {
      display: none;
    }
    [data-view='auto'] .screen[data-screen='mobile'] {
      display: grid;
    }
    .screen {
      padding: .5rem;
    }
    .image-link {
      padding: .35rem;
    }
    button {
      padding-inline: .45rem;
      font-size: .75rem;
    }
  }
  @media (max-height: 32rem) {
    .view-controls {
      padding: .2rem;
    }
    button {
      min-height: 2rem;
      padding: .2rem .25rem;
      font-size: .7rem;
    }
    .action-title {
      padding: .3rem .6rem 0;
      font-size: .75rem;
      line-height: 1.3;
    }
    .image-link {
      padding: .3rem;
    }
    .enlarge {
      /* Увеличение остаётся доступным по самому снимку. */
      display: none;
    }
  }
  @media print {
    .screenshot-carousel .screen, .screenshot-carousel .action-frame {
      display: block;
      height: auto;
      overflow: visible;
    }
    .screenshot-carousel .action-frame {
      break-inside: avoid;
      margin-bottom: 1rem;
    }
    .screenshot-carousel img {
      width: auto;
      height: auto;
      max-height: none;
    }
    .view-controls, .enlarge {
      display: none;
    }
  }
</style>
