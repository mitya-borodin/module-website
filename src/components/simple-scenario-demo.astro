---
const scenarios = [
  {
    id: 'lighting',
    label: 'Свет по движению',
    room: 'Прихожая',
    title: 'Свет в прихожей',
    description: 'Включается, когда вы входите. Гаснет, когда движение прекратилось.',
    triggerLabel: 'Датчик движения',
    triggers: ['Датчик в прихожей', 'Датчик у лестницы'],
    actionLabel: 'Какой свет включить',
    actions: ['Основной свет в прихожей', 'Подсветка в прихожей'],
    finish: 'Выключить без движения через',
    delays: ['30 секунд', '1 минуту', '2 минуты', '5 минут'],
    selectedDelay: '2 минуты',
    summary: 'Датчик в прихожей обнаружит движение, а освещённость будет ниже 100 лк → включится основной свет в прихожей. Через 2 минуты без движения свет выключится.',
  },
  {
    id: 'fan',
    label: 'Вентилятор за светом',
    room: 'Ванная',
    title: 'Вентиляция в ванной',
    description: 'Работает вместе со светом и ещё немного после его выключения.',
    triggerLabel: 'Когда включается',
    triggers: ['Свет в ванной', 'Свет в санузле'],
    actionLabel: 'Что включить вместе со светом',
    actions: ['Вентилятор в ванной', 'Вентилятор в санузле'],
    finish: 'После выключения света работать ещё',
    delays: ['1 минуту', '3 минуты', '5 минут', '10 минут'],
    selectedDelay: '3 минуты',
    summary: 'Включится свет в ванной → заработает вентилятор в ванной. После выключения света он проработает ещё 3 минуты. Если свет включится снова, отсчёт отменится.',
  },
];

const formats = [
  { id: 'phone', label: 'Телефон', path: 'M9 2h6a2 2 0 0 1 2 2v16a2 2 0 0 1-2 2H9a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2Zm1 17h4' },
  { id: 'tablet', label: 'Планшет', path: 'M5 3h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2Zm6 15h2' },
  { id: 'desktop', label: 'Компьютер', path: 'M3 3h18v13H3V3Zm5 18h8m-4-5v5' },
];
---

<section class="section scenario-demo" id="simple-scenarios" aria-labelledby="scenario-demo-title" data-scenario-demo>
  <div class="shell">
    <div class="demo-heading">
      <div>
        <p class="eyebrow">Простые сценарии</p>
        <h2 class="section-title" id="scenario-demo-title">Понятная задача.<br />Понятные настройки.</h2>
      </div>
      <p class="demo-intro">Выберите, что должно произойти, укажите устройства и время. Посмотрите два примера на разных экранах.</p>
    </div>

    <div class="demo-toolbar">
      <div class="scenario-picker" role="group" aria-label="Пример сценария">
        {scenarios.map((scenario, index) => (
          <button type="button" class="scenario-choice" data-scenario={scenario.id} aria-pressed={index === 0 ? 'true' : 'false'} aria-controls={`demo-${scenario.id}`} disabled>
            <span class="choice-number" aria-hidden="true">0{index + 1}</span>{scenario.label}
          </button>
        ))}
      </div>
      <div class="format-picker" role="group" aria-label="Формат экрана">
        {formats.map((format) => (
          <button type="button" class="format-choice" data-format={format.id} aria-pressed={format.id === 'desktop' ? 'true' : 'false'} aria-controls="scenario-preview" disabled>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={format.path} /></svg>
            <span>{format.label}</span>
          </button>
        ))}
      </div>
    </div>

    <p class="demo-disclosure"><span class="concept-label">Концепция интерфейса</span>Интерактивный пример будущих упрощённых настроек. К оборудованию не подключён.</p>
    <noscript><p>Для переключения примеров и форматов экрана включите JavaScript.</p></noscript>

    <div class="preview-stage">
      <div class="preview-frame" id="scenario-preview" data-device="desktop">
        <div class="preview-bar">
          <span class="preview-brand"><span aria-hidden="true">M</span> Module</span>
          <span class="preview-breadcrumb">Сценарии <span aria-hidden="true">/</span> Настройка</span>
        </div>
        <div class="preview-content">
          {scenarios.map((scenario, index) => (
            <article id={`demo-${scenario.id}`} class="scenario-screen" data-screen={scenario.id} hidden={index !== 0} aria-labelledby={`demo-${scenario.id}-title`}>
              <header class="screen-heading">
                <p class="screen-room">{scenario.room}</p>
                <h3 id={`demo-${scenario.id}-title`}>{scenario.title}</h3>
                <p>{scenario.description}</p>
              </header>
              <form class="scenario-form" data-example-form={scenario.id}>
                <div class="settings-grid">
                  <fieldset>
                    <legend><span aria-hidden="true">01</span> Когда</legend>
                    <label class="demo-field">
                      <span>{scenario.triggerLabel}</span>
                      <select name="trigger">{scenario.triggers.map((trigger) => <option>{trigger}</option>)}</select>
                    </label>
                    {scenario.id === 'lighting' ? (
                      <>
                        <label class="demo-check"><input type="checkbox" name="onlyDark" checked /><span>Только когда темно</span></label>
                        <label class="demo-field light-threshold" data-threshold-field>
                          <span>Освещённость ниже</span>
                          <select name="threshold"><option value="50">50 лк</option><option value="100" selected>100 лк</option><option value="200">200 лк</option></select>
                        </label>
                      </>
                    ) : (
                      <p class="field-hint">Включение света запускает вентилятор. Дополнительная кнопка не нужна.</p>
                    )}
                  </fieldset>
                  <fieldset>
                    <legend><span aria-hidden="true">02</span> Что сделать</legend>
                    <label class="demo-field">
                      <span>{scenario.actionLabel}</span>
                      <select name="action">{scenario.actions.map((action) => <option>{action}</option>)}</select>
                    </label>
                    <label class="demo-field">
                      <span>{scenario.finish}</span>
                      <select name="delay">{scenario.delays.map((delay) => <option selected={delay === scenario.selectedDelay}>{delay}</option>)}</select>
                    </label>
                    <p class="field-hint">{scenario.id === 'lighting' ? 'Новое движение начинает отсчёт заново.' : 'Повторное включение света отменяет отсчёт выключения.'}</p>
                  </fieldset>
                </div>
                <div class="scenario-result">
                  <span class="result-marker" aria-hidden="true">↳</span>
                  <div><h4>Как будет работать</h4><p data-summary aria-live="polite">{scenario.summary}</p></div>
                </div>
              </form>
            </article>
          ))}
        </div>
      </div>
    </div>
    <p class="demo-footer">Меняйте параметры — описание сценария обновится. Для действующей версии Module есть <a href="/ru/docs/automations/lighting/setup/">инструкция настройки освещения ↗</a>.</p>
    <span class="sr-only" data-format-status aria-live="polite"></span>
  </div>
</section>

<script>
  for (const demo of document.querySelectorAll<HTMLElement>('[data-scenario-demo]')) {
    const frame = demo.querySelector<HTMLElement>('.preview-frame');
    const formatStatus = demo.querySelector<HTMLElement>('[data-format-status]');
    const scenarioButtons = demo.querySelectorAll<HTMLButtonElement>('[data-scenario]');
    const formatButtons = demo.querySelectorAll<HTMLButtonElement>('[data-format]');
    const screens = demo.querySelectorAll<HTMLElement>('[data-screen]');

    for (const button of scenarioButtons) {
      button.disabled = false;
      button.addEventListener('click', () => {
        for (const choice of scenarioButtons) {
          choice.setAttribute('aria-pressed', String(choice === button));
        }

        for (const screen of screens) {
          screen.hidden = screen.dataset.screen !== button.dataset.scenario;
        }
      });
    }

    for (const button of formatButtons) {
      button.disabled = false;
      button.addEventListener('click', () => {
        if (!frame) {
          return;
        }

        frame.dataset.device = button.dataset.format;

        for (const choice of formatButtons) {
          choice.setAttribute('aria-pressed', String(choice === button));
        }

        if (formatStatus) {
          formatStatus.textContent = `Формат примера: ${button.textContent?.trim()}.`;
        }
      });
    }

    for (const form of demo.querySelectorAll<HTMLFormElement>('[data-example-form]')) {
      form.addEventListener('submit', (event) => {
        event.preventDefault();
      });

      form.addEventListener('change', () => {
        const values = new FormData(form);
        const trigger = String(values.get('trigger'));
        const action = String(values.get('action')).toLocaleLowerCase('ru');
        const delay = String(values.get('delay'));
        const summary = form.querySelector<HTMLElement>('[data-summary]');

        if (!summary) {
          return;
        }

        if (form.dataset.exampleForm === 'lighting') {
          const onlyDark = values.has('onlyDark');
          const thresholdField = form.querySelector<HTMLElement>('[data-threshold-field]');

          if (thresholdField) {
            thresholdField.hidden = !onlyDark;
          }

          const condition = onlyDark ? `, а освещённость будет ниже ${values.get('threshold')} лк` : '';
          summary.textContent = `${trigger} обнаружит движение${condition} → включится ${action}. Через ${delay} без движения свет выключится.`;
        } else {
          summary.textContent = `Включится ${trigger.toLocaleLowerCase('ru')} → заработает ${action}. После выключения света он проработает ещё ${delay}. Если свет включится снова, отсчёт отменится.`;
        }
      });
    }
  }
</script>

<style>
  .scenario-demo {
    background: var(--paper-strong);
  }

  .demo-heading {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    align-items: end;
    gap: 32px;
  }

  .demo-intro {
    max-width: 440px;
    margin: 0;
    color: var(--muted);
    font-size: 19px;
    line-height: 1.5;
  }

  .demo-toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin-top: 40px;
  }

  .scenario-picker,
  .format-picker {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .scenario-choice,
  .format-choice {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 10px 12px;
    border: 1px solid transparent;
    border-radius: var(--radius);
    color: var(--muted);
    background: transparent;
    font-size: 14px;
    cursor: pointer;
  }

  .scenario-choice[aria-pressed='true'] {
    border-color: var(--ink);
    color: var(--paper-strong);
    background: var(--ink);
  }

  .format-choice[aria-pressed='true'] {
    border-color: var(--ink);
    color: var(--ink);
    background: var(--paper);
  }

  .scenario-choice:hover,
  .format-choice:hover {
    border-color: var(--ink);
  }

  .choice-number {
    font-family: var(--mono);
    font-size: 11px;
    opacity: 0.7;
  }

  .demo-disclosure {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 12px;
    margin: 24px 0 18px;
    color: var(--muted);
    font-size: 13px;
    line-height: 1.5;
  }

  .concept-label {
    color: var(--ink);
    font-weight: 700;
  }

  .preview-stage {
    padding: clamp(10px, 2vw, 28px);
    border: 1px solid color-mix(in srgb, var(--line) 18%, transparent);
    background: var(--paper);
  }

  .preview-frame {
    width: 100%;
    max-width: 1120px;
    margin-inline: auto;
    border: 1px solid color-mix(in srgb, var(--line) 25%, transparent);
    border-radius: 12px;
    background: var(--paper-strong);
    box-shadow: 0 12px 32px rgb(23 24 20 / 6%);
    container-type: inline-size;
    transition: max-width 220ms ease;
  }

  .preview-frame[data-device='tablet'] {
    max-width: 768px;
  }

  .preview-frame[data-device='phone'] {
    max-width: 390px;
  }

  .preview-bar {
    display: flex;
    min-height: 62px;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    padding: 14px 24px;
    border-bottom: 1px solid color-mix(in srgb, var(--line) 15%, transparent);
  }

  .preview-brand {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-weight: 800;
  }

  .preview-brand > span {
    display: grid;
    width: 26px;
    height: 26px;
    place-items: center;
    color: var(--paper-strong);
    background: var(--ink);
    font-size: 14px;
  }

  .preview-breadcrumb {
    color: var(--muted);
    font-size: 12px;
  }

  .preview-breadcrumb > span {
    padding-inline: 5px;
  }

  .preview-content {
    padding: 28px;
  }

  .screen-heading h3 {
    margin: 8px 0;
    font-size: clamp(24px, 3cqi, 32px);
    line-height: 1.15;
    letter-spacing: -0.035em;
  }

  .screen-heading > p:not(.screen-room) {
    max-width: 540px;
    margin: 10px 0 0;
    color: var(--muted);
    font-size: 14px;
    line-height: 1.5;
  }

  .screen-room {
    margin: 0;
    color: var(--muted);
    font-size: 12px;
  }

  .settings-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 28px;
    margin-top: 28px;
  }

  fieldset {
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }

  legend {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 20px;
    padding: 0;
    font-size: 16px;
    font-weight: 750;
  }

  legend > span {
    font-family: var(--mono);
    font-size: 11px;
    font-weight: 400;
    color: var(--muted);
  }

  .demo-field {
    display: grid;
    gap: 8px;
    margin-bottom: 18px;
    font-size: 13px;
    line-height: 1.4;
  }

  .demo-field select {
    width: 100%;
    min-width: 0;
    min-height: 44px;
    padding: 10px 8px;
    border: 1px solid color-mix(in srgb, var(--line) 28%, transparent);
    border-radius: 6px;
    color: var(--ink);
    background: var(--paper-strong);
    font: inherit;
    font-size: 16px;
  }

  .demo-check {
    display: flex;
    min-height: 44px;
    align-items: center;
    gap: 8px;
    margin-bottom: 8px;
    font-size: 14px;
    cursor: pointer;
  }

  .demo-check input {
    width: 18px;
    height: 18px;
    margin: 0;
    accent-color: var(--accent-dark);
  }

  .field-hint {
    margin: 0;
    color: var(--muted);
    font-size: 12px;
    line-height: 1.5;
  }

  .scenario-result {
    display: flex;
    align-items: start;
    gap: 14px;
    margin-top: 24px;
    padding-top: 22px;
    border-top: 1px solid color-mix(in srgb, var(--line) 18%, transparent);
  }

  .result-marker {
    color: var(--accent-dark);
    font-size: 24px;
    line-height: 1;
  }

  .scenario-result h4 {
    margin: 0 0 8px;
    font-size: 13px;
    font-weight: 750;
  }

  .scenario-result p {
    max-width: 720px;
    margin: 0;
    font-size: 14px;
    line-height: 1.6;
  }

  .demo-footer {
    max-width: 850px;
    margin: 20px 0 0;
    color: var(--muted);
    font-size: 14px;
    line-height: 1.6;
  }

  .demo-footer a {
    color: var(--ink);
  }

  .scenario-demo [hidden] {
    display: none;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  @container (max-width: 550px) {
    .preview-content {
      padding: 20px 16px;
    }

    .preview-bar {
      padding: 12px 16px;
    }

    .preview-breadcrumb {
      display: none;
    }

    .settings-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 24px;
    }
  }

  @media (max-width: 760px) {
    .demo-heading {
      grid-template-columns: minmax(0, 1fr);
      gap: 24px;
    }

    .demo-intro {
      font-size: 17px;
    }

    .scenario-picker {
      width: 100%;
    }

    .scenario-choice {
      flex: 1 1 180px;
    }

    .format-picker {
      width: 100%;
      justify-content: space-between;
    }

    .format-choice {
      flex: 1 1 0;
      flex-direction: column;
      gap: 6px;
      padding: 10px 6px;
      font-size: 12px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .preview-frame {
      transition: none;
    }
  }
</style>
