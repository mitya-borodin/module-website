---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  image: ImageMetadata;
  alt: string;
  caption: string;
}

const { image, alt, caption } = Astro.props;
---

<figure class="docs-scenario-image">
  <Image
    class="docs-illustration"
    src={image}
    alt={alt}
    layout="constrained"
    widths={[320, 640, 960, 1440]}
    sizes="(min-width: 80rem) 60vw, (min-width: 50rem) 70vw, 100vw"
    loading="lazy"
    decoding="async"
  />
  <figcaption>{caption}</figcaption>
</figure>

<style>
  .docs-scenario-image {
    margin: 1.25rem 0 1.5rem;
  }

  .docs-scenario-image :global(img) {
    display: block;
    width: 100%;
    height: auto;
    margin: 0;
  }

  figcaption {
    margin-top: 0.625rem;
    color: var(--sl-color-gray-2);
    font-size: 0.875rem;
    line-height: 1.5;
  }
</style>
