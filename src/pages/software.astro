---
import { Image } from 'astro:assets';
import SiteLayout from '../layouts/site-layout.astro';
import ContactChannels from '../components/contact-channels.astro';
import SoftwareApproaches from '../components/software-approaches.astro';
import SoftwareAutomationScene from '../components/software-automation-scene.astro';
import { automationGroups } from '../data/automation-catalog';
import browserControl from '../assets/site/browser-control-concept-v1.png';
import roomControl from '../assets/site/automation-home-concept-v1.png';
import resourceReadings from '../assets/docs/resource-metering/resource-metering-concept-v1.png';
import '../styles/commercial-content.css';

const guiPreviewSlots = [
  {
    id: 'overview', number: '01', label: 'Обзор дома', title: 'Что происходит дома',
    description: 'Состояния освещения, температура и другие показания подключённых устройств — чтобы оценить обстановку в доме.',
    replacement: 'Здесь появится реальный экран обзора дома.',
    image: browserControl,
    alt: 'Иллюстрация: человек смотрит домашние системы с ноутбука и телефона. На экранах условная графика.',
  },
  {
    id: 'room', number: '02', label: 'Управление комнатой', title: 'Нужный вам режим',
    description: 'Показания и доступные действия для выбранной комнаты: например, температура и состояние освещения.',
    replacement: 'Здесь появится реальный экран управления комнатой.',
    image: roomControl,
    alt: 'Иллюстрация комнаты с освещением, радиатором и шторами; человек читает на диване.',
  },
  {
    id: 'resources', number: '03', label: 'Учёт ресурсов', title: 'Сколько расходуется сейчас',
    description: 'Показания совместимых счётчиков и расчётная скорость расхода воды, электричества, газа или тепла.',
    replacement: 'Здесь появится реальный экран показаний и расхода ресурсов.',
    image: resourceReadings,
    alt: 'Иллюстрация домашних систем со счётчиками воды, электричества, газа и тепла.',
  },
];
---

<SiteLayout
  title="ПО Module — автоматизации света, тепла, воды и приводов"
  description="Что умеет Module: освещение, климат, защита от утечек, горячая вода, шторы, приводы и учёт ресурсов. Наглядные сценарии и готовые автоматизации для вашего объекта."
>
  <section class="section commercial-hero" aria-labelledby="software-title">
    <div class="shell">
      <a class="back-link" href="/">← Проектирование и сборка систем</a>
      <div class="overview-grid software-overview">
        <div class="overview-copy">
          <p class="eyebrow">ПО Module</p>
          <h1 id="software-title">Готовые автоматизации для <span>инженерных систем.</span></h1>
          <p class="hero-lede">Вы занимаетесь своими делами. Свет, климат и другие системы выполняют выбранные задачи.</p>
          <p class="hero-explanation">В комнатах — освещение, шторы и нужная температура. В инженерных системах — отопление, горячая вода, защита от утечек и учёт ресурсов.</p>
        </div>
        <SoftwareAutomationScene />
        <div class="actions overview-actions">
          <a class="button" href="#automations">Выбрать свою задачу ↓</a>
          <a class="button button--secondary" href="#software-contact">Обсудить ПО ↗</a>
        </div>
      </div>
      <div class="logic-explanation" id="operation" aria-labelledby="operation-title">
        <h2 id="operation-title">Как это работает: пример освещения</h2>
        <ol class="logic-strip">
          <li><span class="item-number">01 / Датчик</span><h3>Замечает движение</h3><p>Сообщает об активности в прихожей.</p></li>
          <li><span class="item-number">02 / Module</span><h3>Проверяет условия</h3><p>Определяет, нужен ли свет, и передаёт команду включить его.</p></li>
          <li><span class="item-number">03 / Освещение</span><h3>Работает нужное время</h3><p>Гаснет после прекращения активности с выбранной задержкой.</p></li>
        </ol>
        <a class="text-link" href="/ru/docs/automations/lighting/">Сценарии освещения и условия их работы →</a>
      </div>
    </div>
  </section>

  <section class="section catalog-section" id="automations" aria-labelledby="automations-title">
    <div class="shell">
      <div class="section-heading">
        <div><p class="eyebrow">Возможности Module</p><h2 class="section-title" id="automations-title">Что нужно вашему объекту?</h2></div>
        <a class="text-link" href="/ru/docs/">Все разделы документации →</a>
      </div>
      <p class="lede">Выберите результат. В каждом описании — поведение системы, варианты применения и условия, которые нужно учесть.</p>
      <nav class="catalog-nav" aria-label="Разделы автоматизаций">
        {automationGroups.map((group) => <a href={`#${group.id}`}>{group.title}</a>)}
      </nav>
      <div class="visual-catalog software-catalog">
        {automationGroups.map((group) => group.automations.map((item, index) => (
          <article class="visual-card" id={index === 0 ? group.id : item.slug} aria-labelledby={`${item.slug}-title`}>
            <div class="visual-card-media">
              <Image src={item.image} alt={item.alt} widths={[360, 640, 960]}
                sizes="(max-width: 650px) 92vw, (max-width: 1100px) 45vw, 30vw" format="webp" loading="lazy" />
            </div>
            <div class="visual-card-copy">
              <p class="card-category">{item.title}</p>
              <h3 id={`${item.slug}-title`}>{item.result}</h3>
              <p>{item.description}</p>
              <a class="text-link" href={`/ru/docs/automations/${item.slug}/`}>Возможности и сценарии<span class="visually-hidden">: {item.title}</span><span aria-hidden="true"> →</span></a>
            </div>
          </article>
        )))}
      </div>
    </div>
  </section>

  <section class="section software-section" id="management" aria-labelledby="interface-title">
    <div class="shell">
      <div class="management-heading">
        <p class="eyebrow">Повседневное управление</p>
        <h2 class="section-title" id="interface-title">Система под вашим контролем.</h2>
        <p class="lede">Откройте Module в браузере: посмотрите показания подключённых устройств и управляйте доступными параметрами автоматизаций.</p>
        <p class="gui-preview-note">Пока показываем иллюстрации. После готовности дашборда здесь появятся реальные экраны Module.</p>
      </div>
      <div class="gui-previews">
        {guiPreviewSlots.map((slot, index) => (
          <figure class:list={['gui-preview', { 'gui-preview--overview': index === 0 }]}
            id={`gui-${slot.id}`} data-gui-slot={slot.id} aria-labelledby={`gui-${slot.id}-title`}>
            <div class="gui-preview-frame">
              <div class="gui-preview-toolbar">
                <span>{slot.number} / {slot.label}</span>
                <span class="gui-preview-badge">Иллюстрация</span>
              </div>
              <Image src={slot.image} alt={slot.alt} class="gui-preview-art"
                widths={[480, 768, 1024, 1536]} sizes={index === 0 ? '(max-width: 850px) 94vw, 58vw' : '(max-width: 650px) 94vw, 46vw'}
                format="webp" loading="lazy" />
            </div>
            <figcaption>
              <h3 id={`gui-${slot.id}-title`}>{slot.title}</h3>
              <p>{slot.description}</p>
              <p class="gui-preview-replacement">{slot.replacement}</p>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <SoftwareApproaches audience="software" />

  <section class="section" aria-labelledby="compatibility-title">
    <div class="shell information-grid">
      <div><p class="eyebrow">От результата к реализации</p><h2 class="section-title" id="compatibility-title">Подберём оборудование и условия работы.</h2></div>
      <div class="information-copy">
        <p>Расскажите, что хотите автоматизировать. Если оборудование уже есть или выбрано, проверим, можно ли использовать его с Module. Недостающее поможем подобрать.</p>
        <ul>
          <li>Согласуем, что система делает сама и как сохраняется ручное управление.</li>
          <li>Определим поведение при неисправности и необходимые меры защиты.</li>
          <li>Согласуем, как после подключения проверить сценарии на объекте.</li>
        </ul>
        <p>Для ворот и дверей отдельно согласуем доступ и защиту от защемления. Команда открытия или закрытия сама по себе их не обеспечивает.</p>
      </div>
    </div>
  </section>

  <section class="section dark-section" id="purchase" aria-labelledby="package-title">
    <div class="shell">
      <p class="eyebrow">С чего начать</p>
      <h2 class="section-title" id="package-title">Как приобрести Module.</h2>
      <div class="information-grid purchase-options">
        <div class="information-copy software-offer">
          <h3 id="software-contact">Покупка и настройка ПО</h3>
          <p>
            Расскажите, какое оборудование планируете использовать и что хотите автоматизировать.
            Проверим, подойдёт ли Module для ваших задач, и обсудим стоимость и условия покупки ПО.
            Заказывать проект и щит для этого не нужно.
          </p>
          <ContactChannels label="Связаться по поводу покупки и настройки ПО Module" emailSubject="Покупка и настройка ПО Module" />
        </div>
        <div class="information-copy software-offer">
          <h3>Нужны проект и собранный щит?</h3>
          <p>
            Можем взять на себя и подготовку оборудования: спроектируем автоматизацию, подберём
            и закупим нужные устройства, соберём щит и настроим сценарии. После сборки проверим
            все согласованные сценарии в лаборатории и доставим щит вместе с проектом
            и документами для подключения.
          </p>
          <p>Монтаж, подключение и запуск на объекте согласуем отдельно.</p>
          <a class="text-link" href="/#process">Как мы проектируем и собираем щиты ↗</a>
        </div>
      </div>
    </div>
  </section>
</SiteLayout>

<style>
  .management-heading {
    max-width: 920px;
  }

  .gui-preview-note {
    max-width: 760px;
    margin: 24px 0 0;
    padding-left: 16px;
    border-left: 3px solid var(--accent-dark);
    font-size: 14px;
    line-height: 1.6;
  }

  .gui-previews {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 28px;
    margin-top: 36px;
  }

  .gui-preview {
    min-width: 0;
    margin: 0;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 16px;
    background: var(--paper-strong);
    scroll-margin-top: 100px;
  }

  .gui-preview--overview {
    display: grid;
    grid-column: 1 / -1;
    grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
    align-items: center;
  }

  .gui-preview-frame {
    min-width: 0;
    background: var(--paper);
  }

  .gui-preview-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 10px;
    min-height: 52px;
    padding: 12px 20px;
    border-bottom: 1px solid var(--line);
    font-size: 12px;
    font-weight: 650;
    line-height: 1.5;
  }

  .gui-preview-badge {
    padding: 4px 8px;
    border: 1px dashed var(--accent-dark);
    border-radius: 4px;
    color: var(--accent-dark);
    font-size: 11px;
  }

  .gui-preview-art {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 10;
    object-fit: contain;
  }

  .gui-preview figcaption {
    padding: clamp(22px, 3vw, 40px);
  }

  .gui-preview h3 {
    margin: 0 0 16px;
    font-size: clamp(24px, 2.2vw, 30px);
    line-height: 1.15;
    letter-spacing: -0.035em;
  }

  .gui-preview figcaption > p {
    margin: 0;
    font-size: 16px;
    line-height: 1.6;
  }

  .gui-preview figcaption > .gui-preview-replacement {
    margin-top: 20px;
    padding-top: 16px;
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: 13px;
  }

  @media (max-width: 850px) {
    .gui-preview--overview {
      display: block;
    }
  }

  @media (max-width: 650px) {
    .gui-previews {
      grid-template-columns: minmax(0, 1fr);
      gap: 24px;
    }
  }

</style>
