---
import { Image } from 'astro:assets';
import SiteLayout from '../layouts/site-layout.astro';
import ContactChannels from '../components/contact-channels.astro';
import SoftwareApproaches from '../components/software-approaches.astro';
import SoftwareAutomationScene from '../components/software-automation-scene.astro';
import { automationGroups } from '../data/automation-catalog';
import browserControl from '../assets/site/gui-dashboard-interior-v1.png';
import manualControl from '../assets/site/gui-manual-interior-v1.png';
import deviceMarkup from '../assets/site/gui-devices-interior-v1.png';
import automationCreation from '../assets/site/gui-create-interior-v1.png';
import notifications from '../assets/site/gui-notifications-interior-v1.png';
import '../styles/commercial-content.css';

const guiPreviewSlots = [
  {
    id: 'overview', number: '01', label: 'Дашборд', title: 'Вся система перед глазами',
    description: 'Общий обзор объекта: состояния систем, температура, показания и расход ресурсов.',
    replacement: 'Здесь покажем реальный дашборд Ritmod.',
    slides: [{ image: browserControl, alt: 'Концептуальная иллюстрация: обзор домашних систем на ноутбуке и телефоне.' }],
  },
  {
    id: 'room', number: '02', label: 'Ручное управление', title: 'Вы выбираете, что происходит сейчас',
    description: 'Примеры ручного управления сценариями: выбрать режим под занятие, включить нужный свет или изменить доступные параметры.',
    replacement: 'Здесь покажем ручное управление сценариями в интерфейсе Ritmod.',
    slides: [{ image: manualControl, alt: 'Иллюстрация: человек выбирает режим просмотра кино на телефоне в гостиной с приглушённым светом.' }],
  },
  {
    id: 'devices', number: '03', label: 'Разметка устройств', title: 'У каждого устройства — понятная роль',
    description: 'Названия, помещения и назначение устройств помогают связать оборудование объекта с его отображением в программе.',
    replacement: 'Здесь покажем разметку устройств на реальном примере.',
    slides: [{ image: deviceMarkup, alt: 'Иллюстрация: специалист с планшетом связывает настенный датчик с оборудованием щита и комнатой.' }],
  },
  {
    id: 'automations', number: '04', label: 'Создание автоматизаций', title: 'От задачи — к нужному поведению',
    description: 'На примере освещения покажем путь от выбора автоматизации и устройств до условий работы и включения.',
    replacement: 'Здесь покажем создание автоматизации по шагам.',
    slides: [{ image: automationCreation, alt: 'Иллюстрация: специалист и заказчик обсуждают работу домашней автоматизации за ноутбуком.' }],
  },
  {
    id: 'notifications', number: '05', label: 'Уведомления и интерактив', title: 'Сообщение и следующий шаг',
    description: 'В этом блоке покажем сообщения системы и примеры взаимодействия с ними — от получения информации до ответа пользователя.',
    replacement: 'Здесь появятся реальные примеры уведомлений и интерактива.',
    slides: [{ image: notifications, alt: 'Концептуальная иллюстрация: человек читает условное сообщение и нажимает кнопку на телефоне.' }],
  },
];
---

<SiteLayout
  title="ПО Ritmod — автоматизации света, тепла, воды и приводов"
  description="ПО Ritmod управляет светом, климатом, водой и приводами. Готовые автоматизации, управление из браузера и сценарии для разных зон. ПО можно приобрести отдельно."
>
  <section class="section product-hero" aria-labelledby="software-title">
    <div class="shell">
      <a class="back-link" href="/">← Проектирование и сборка систем</a>
      <div class="product-intro">
        <p class="eyebrow">Ritmod / программное обеспечение</p>
        <h1 id="software-title">Ritmod управляет <span>системами вашего объекта.</span></h1>
        <p class="hero-lede">Свет, климат, вода и приводы работают по вашим условиям — с готовыми автоматизациями в одной программе.</p>
        <div class="actions product-actions">
          <a class="button" href="#automations">Смотреть автоматизации ↓</a>
          <a class="button button--secondary" href="#purchase">Приобрести ПО ↗</a>
        </div>
      </div>
      <div class="product-stage">
        <SoftwareAutomationScene />
      </div>
      <div class="logic-explanation" id="operation" aria-labelledby="operation-title">
        <h2 id="operation-title">Как это работает: пример освещения</h2>
        <p class="hero-explanation">Ritmod получает показания датчиков и передаёт команды оборудованию. Для каждой зоны можно выбрать своё поведение и сохранить ручное управление.</p>
        <ol class="logic-strip">
          <li><span class="item-number">01 / Датчик</span><h3>Замечает движение</h3><p>Сообщает об активности в прихожей.</p></li>
          <li><span class="item-number">02 / Ritmod</span><h3>Проверяет условия</h3><p>Определяет, нужен ли свет, и передаёт команду включить его.</p></li>
          <li><span class="item-number">03 / Освещение</span><h3>Работает нужное время</h3><p>Гаснет после прекращения активности с выбранной задержкой.</p></li>
        </ol>
        <a class="text-link" href="/ru/docs/automations/lighting/">Сценарии освещения и условия их работы →</a>
      </div>
    </div>
  </section>

  <section class="section catalog-section" id="automations" aria-labelledby="automations-title">
    <div class="shell">
      <div class="section-heading">
        <div><p class="eyebrow">Возможности Ritmod</p><h2 class="section-title" id="automations-title">Что умеет Ritmod.</h2></div>
        <a class="text-link" href="/ru/docs/">Все разделы документации →</a>
      </div>
      <p class="lede">Посмотрите, какие задачи можно поручить Ritmod. В каждом описании — поведение системы, варианты применения и условия, которые нужно учесть.</p>
      <nav class="catalog-nav" aria-label="Разделы автоматизаций">
        {automationGroups.map((group) => <a href={`#${group.id}`}>{group.title}</a>)}
      </nav>
      <div class="visual-catalog software-catalog">
        {automationGroups.map((group) => group.automations.map((item, index) => (
          <article class="visual-card" id={index === 0 ? group.id : item.slug} aria-labelledby={`${item.slug}-title`}>
            <div class="visual-card-media">
              <Image src={item.image} alt={item.alt} widths={[360, 640, 960]}
                sizes="(max-width: 650px) 92vw, (max-width: 1100px) 45vw, 30vw" format="webp" loading="lazy" />
              <svg class="catalog-markers" viewBox="0 0 1536 1024" fill="none" aria-hidden="true">
                {item.targets.map((target) => (
                  <g>
                    <circle class="catalog-marker" cx={target.x} cy={target.y} r="24" />
                    <circle class="catalog-marker-core" cx={target.x} cy={target.y} r="5" />
                  </g>
                ))}
              </svg>
              <span class="catalog-action">{item.action}</span>
            </div>
            <div class="visual-card-copy">
              <p class="card-category">{item.title}</p>
              <h3 id={`${item.slug}-title`}>{item.result}</h3>
              <p>{item.description}</p>
              <a class="text-link" href={`/ru/docs/automations/${item.slug}/`}>Возможности и сценарии<span class="visually-hidden">: {item.title}</span><span aria-hidden="true"> →</span></a>
            </div>
          </article>
        )))}
      </div>
    </div>
  </section>

  <section class="section software-section" id="management" aria-labelledby="interface-title">
    <div class="shell">
      <div class="management-heading">
        <p class="eyebrow">Интерфейс Ritmod</p>
        <h2 class="section-title" id="interface-title">Управление и настройка в браузере.</h2>
        <p class="lede">От повседневного управления до подготовки системы: пять аспектов работы с Ritmod.</p>
        <p class="gui-preview-note">Пока здесь иллюстрации. По мере готовности добавим реальные экраны и примеры действий в Ritmod.</p>
      </div>
      <nav class="gui-aspects" aria-label="Аспекты интерфейса Ritmod">
        {guiPreviewSlots.map((slot) => <a href={`#gui-${slot.id}`}>{slot.label}</a>)}
      </nav>
      <div class="gui-previews">
        {guiPreviewSlots.map((slot, index) => (
          <figure class:list={['gui-preview', { 'gui-preview--overview': index === 0 }]}
            id={`gui-${slot.id}`} data-gui-slot={slot.id} aria-labelledby={`gui-${slot.id}-title`}>
            <div class="gui-preview-frame">
              <div class="gui-preview-toolbar">
                <span>{slot.number} / {slot.label}</span>
                <span class="gui-preview-badge">Иллюстрация</span>
              </div>
              <div class="gui-slides" tabindex={slot.slides.length > 1 ? 0 : undefined}
                role={slot.slides.length > 1 ? 'region' : undefined}
                aria-label={slot.slides.length > 1 ? `Экраны: ${slot.label}` : undefined}>
                {slot.slides.map((slide, slideIndex) => (
                  <div class="gui-slide" id={`gui-${slot.id}-slide-${slideIndex + 1}`}>
                    <Image src={slide.image} alt={slide.alt} class="gui-preview-art"
                      widths={[480, 768, 1024, 1536]} sizes={index === 0 ? '(max-width: 850px) 94vw, 58vw' : '(max-width: 650px) 94vw, 46vw'}
                      format="webp" loading="lazy" />
                  </div>
                ))}
              </div>
              {slot.slides.length > 1 && (
                <nav class="gui-slide-links" aria-label={`Выбрать экран: ${slot.label}`}>
                  {slot.slides.map((_, slideIndex) => <a href={`#gui-${slot.id}-slide-${slideIndex + 1}`}>Экран {slideIndex + 1}</a>)}
                </nav>
              )}
            </div>
            <figcaption>
              <h3 id={`gui-${slot.id}-title`}>{slot.title}</h3>
              <p>{slot.description}</p>
              <p class="gui-preview-replacement">{slot.replacement}</p>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <SoftwareApproaches audience="software" />

  <section class="section" aria-labelledby="compatibility-title">
    <div class="shell information-grid">
      <div><p class="eyebrow">От результата к реализации</p><h2 class="section-title" id="compatibility-title">Подойдёт ли Ritmod вашей системе?</h2></div>
      <div class="information-copy">
        <p>Расскажите, что хотите автоматизировать. Если оборудование уже есть или выбрано, проверим, можно ли использовать его с Ritmod. Недостающее поможем подобрать.</p>
        <ul>
          <li>Согласуем, что система делает сама и как сохраняется ручное управление.</li>
          <li>Определим поведение при неисправности и необходимые меры защиты.</li>
          <li>Согласуем, как после подключения проверить сценарии на объекте.</li>
        </ul>
        <p>Для ворот и дверей отдельно согласуем доступ и защиту от защемления. Команда открытия или закрытия сама по себе их не обеспечивает.</p>
      </div>
    </div>
  </section>

  <section class="section dark-section" id="purchase" aria-labelledby="package-title">
    <div class="shell">
      <p class="eyebrow">С чего начать</p>
      <h2 class="section-title" id="package-title">Как приобрести Ritmod.</h2>
      <div class="information-grid purchase-options">
        <div class="information-copy software-offer">
          <h3 id="software-contact">Покупка и настройка ПО</h3>
          <p>
            Расскажите, какое оборудование планируете использовать и что хотите автоматизировать.
            Проверим, подойдёт ли Ritmod для ваших задач, и обсудим стоимость и условия покупки ПО.
            Заказывать проект и щит для этого не нужно.
          </p>
          <ContactChannels label="Связаться по поводу покупки и настройки ПО Ritmod" emailSubject="Покупка и настройка ПО Ritmod" />
        </div>
        <div class="information-copy software-offer">
          <h3>Что обсудим перед покупкой</h3>
          <ul>
            <li>Какие автоматизации нужны и в каких зонах они будут работать.</li>
            <li>Какое оборудование уже есть или планируется — проверим совместимость.</li>
            <li>Кто подготовит настройки, подключит оборудование и проверит результат на объекте.</li>
          </ul>
        </div>
      </div>
      <p class="service-crosslink">Нужен комплект с оборудованием? <a href="/#result">Проектирование и сборка щита — отдельная инженерная услуга ↗</a></p>
    </div>
  </section>
</SiteLayout>

<style>
  .product-hero {
    --muted: #b9bcb0;
    --line: #ffffff29;
    padding-block: 28px clamp(48px, 6vw, 88px);
    color: var(--paper-strong);
    background:
      radial-gradient(ellipse at 50% 56%, #d9f99d0d, transparent 65%),
      var(--ink);
  }

  .product-hero .back-link {
    margin-bottom: 32px;
    color: var(--muted);
  }

  .product-intro {
    max-width: 1080px;
    margin-inline: auto;
    text-align: center;
  }

  .product-intro .eyebrow {
    color: var(--signal);
  }

  .product-intro .eyebrow::before {
    border-radius: 50%;
    background: currentColor;
  }

  .product-intro h1 {
    margin: 0;
    font-size: clamp(36px, 5.5vw, 76px);
    font-weight: 850;
    line-height: 1.05;
    letter-spacing: -0.05em;
    text-wrap: balance;
    overflow-wrap: break-word;
  }

  .product-intro h1 span {
    display: block;
    color: var(--signal);
  }

  .product-intro .hero-lede {
    max-width: 740px;
    margin: 24px auto 0;
    color: #dbded2;
    font-size: clamp(18px, 1.7vw, 23px);
    text-wrap: balance;
  }

  .product-actions {
    justify-content: center;
    gap: 12px;
    margin-top: 28px;
  }

  .product-actions .button {
    border-color: var(--signal);
    border-radius: 8px;
    color: var(--ink);
    background: var(--signal);
  }

  .product-actions .button--secondary {
    border-color: #ffffff54;
    color: var(--paper-strong);
    background: transparent;
  }

  .product-actions .button:hover {
    box-shadow: 0 0 0 4px #d9f99d1f;
    translate: 0 -2px;
  }

  .product-actions .button--secondary:hover {
    background: #ffffff0d;
  }

  .product-hero :focus-visible {
    outline-color: var(--signal);
  }

  .product-stage {
    max-width: 1080px;
    margin: 48px auto 0;
  }

  .product-stage :global(.overview-visual) {
    max-width: none;
  }

  .product-stage :global(.spatial-signature > span:first-child) {
    color: var(--signal);
  }

  .product-stage :global(.spatial-signature:focus-visible) {
    outline-color: var(--signal);
  }

  .product-hero .logic-explanation {
    max-width: 1080px;
    margin-inline: auto;
  }

  .product-hero .hero-explanation {
    max-width: 820px;
    margin-top: 20px;
  }

  .product-hero .item-number {
    color: var(--signal);
  }

  @media (max-width: 650px) {
    .product-intro {
      text-align: left;
    }

    .product-intro .eyebrow {
      max-width: 100%;
      font-size: 10px;
    }

    .product-actions {
      justify-content: flex-start;
    }

    .product-stage {
      margin-top: 32px;
    }

    .product-hero .back-link {
      margin-bottom: 28px;
      font-size: 12px;
    }
  }

  .service-crosslink {
    margin: 40px 0 0;
    padding-top: 24px;
    border-top: 1px solid var(--line);
    font-size: 16px;
    line-height: 1.7;
  }

  .management-heading {
    max-width: 920px;
  }

  .gui-preview-note {
    max-width: 760px;
    margin: 24px 0 0;
    padding-left: 16px;
    border-left: 3px solid var(--accent-dark);
    font-size: 14px;
    line-height: 1.6;
  }

  .gui-aspects,
  .gui-slide-links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
    margin-top: 24px;
  }

  .gui-aspects a,
  .gui-slide-links a {
    padding-block: 12px;
    font-size: 14px;
    font-weight: 700;
  }

  .gui-slides {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
  }

  .gui-slide {
    flex: 0 0 100%;
    min-width: 0;
    scroll-snap-align: start;
  }

  .gui-slide-links {
    margin: 0;
    padding-inline: 20px;
  }

  .gui-previews {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 28px;
    margin-top: 36px;
  }

  .gui-preview {
    min-width: 0;
    margin: 0;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 16px;
    background: var(--paper-strong);
    scroll-margin-top: 100px;
  }

  .gui-preview--overview {
    display: grid;
    grid-column: 1 / -1;
    grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
    align-items: center;
  }

  .gui-preview-frame {
    min-width: 0;
    background: var(--paper);
  }

  .gui-preview-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 10px;
    min-height: 52px;
    padding: 12px 20px;
    border-bottom: 1px solid var(--line);
    font-size: 12px;
    font-weight: 650;
    line-height: 1.5;
  }

  .gui-preview-badge {
    padding: 4px 8px;
    border: 1px dashed var(--accent-dark);
    border-radius: 4px;
    color: var(--accent-dark);
    font-size: 11px;
  }

  .gui-preview-art {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 2;
    object-fit: contain;
  }

  .gui-preview figcaption {
    padding: clamp(22px, 3vw, 40px);
  }

  .gui-preview h3 {
    margin: 0 0 16px;
    font-size: clamp(24px, 2.2vw, 30px);
    line-height: 1.15;
    letter-spacing: -0.035em;
  }

  .gui-preview figcaption > p {
    margin: 0;
    font-size: 16px;
    line-height: 1.6;
  }

  .gui-preview figcaption > .gui-preview-replacement {
    margin-top: 20px;
    padding-top: 16px;
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: 13px;
  }

  @media (max-width: 850px) {
    .gui-preview--overview {
      display: block;
    }
  }

  @media (max-width: 650px) {
    .gui-previews {
      grid-template-columns: minmax(0, 1fr);
      gap: 24px;
    }
  }

</style>
