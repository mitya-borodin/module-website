---
import SiteLayout from '../layouts/site-layout.astro';

const deliverables = [
  { title: 'Проект', text: 'Функции объекта, схемы подключения, подобранное оборудование и согласованная смета.', detail: 'Сначала понятно, что и зачем собираем' },
  { title: 'Щит', text: 'Закупленные компоненты и собранный щит автоматизации под ваш проект.', detail: 'Оборудование — в составе одного решения' },
  { title: 'ПО и сценарии', text: 'Module и подготовленные автоматизации для согласованных задач: света, тепла, воды и приводов.', detail: 'Логика работы — часть комплекта' },
  { title: 'Документация', text: 'Материалы для подключения, настройки и эксплуатации в согласованном составе.', detail: 'Чтобы систему можно было передать дальше' },
];

const solutions = [
  { id: 'lighting', title: 'Освещение', text: 'Управление группами света и RGBW-лентами. Реакция на кнопки, движение, освещённость и время.', example: 'Помещение · проход · территория' },
  { id: 'heating', title: 'Отопление и тепло', text: 'Поддержание температуры и совместная работа источников тепла, смесителей, насосов и термостатических приводов.', example: 'Комната · гараж · тепловой контур' },
  { id: 'leaks', title: 'Защита от протечек', text: 'Обнаружение воды по датчикам и команда приводу перекрыть подачу.', example: 'Санузел · техническое помещение' },
  { id: 'recirculation', title: 'Горячая вода', text: 'Запуск насоса рециркуляции по настроенным условиям — без постоянной циркуляции.', example: 'Точки разбора горячей воды' },
  { id: 'drives', title: 'Шторы и приводы', text: 'Открытие, закрытие и управление положением штор, ворот, кранов и заслонок с совместимыми приводами.', example: 'Окно · въезд · инженерный узел' },
  { id: 'metering', title: 'Учёт ресурсов', text: 'Учёт объёма и расхода по импульсам счётчика. Показатели можно использовать в других автоматизациях.', example: 'Счётчик с импульсным выходом' },
];

const process = [
  ['Проектируем', 'Уточняем задачи и составляем проект автоматизации.'],
  ['Подбираем', 'Определяем контроллер, датчики и исполнительные устройства.'],
  ['Считаем', 'Согласовываем состав, стоимость и границы поставки.'],
  ['Закупаем', 'Комплектуем решение согласованным оборудованием.'],
  ['Собираем', 'Собираем щит и подготавливаем ПО и сценарии.'],
  ['Документируем', 'Описываем подключения, настройки и состав комплекта.'],
  ['Доставляем', 'Передаём заказчику оборудование и документацию.'],
];

const objectGroups = [
  ['Жилые', 'Квартиры и дома'],
  ['Хозяйственные', 'Гаражи, сараи и другие постройки'],
  ['Коммерческие', 'Склады, кафе и рестораны'],
  ['Открытые территории', 'Участки и парки'],
];

const contactChannels = [
  { label: 'Email', value: 'dmitriy@borodin.site', href: 'mailto:dmitriy@borodin.site' },
  { label: 'Telegram', value: '@MityaBorodin', href: 'https://t.me/MityaBorodin' },
  { label: 'Телефон', value: '+7 904 676-20-07', href: 'tel:+79046762007' },
  { label: 'WhatsApp', value: '+7 904 676-20-07', href: 'https://wa.me/79046762007' },
  {
    label: 'MAX',
    value: '+7 904 676-20-07',
    href: 'https://max.ru/u/f9LHodD0cOK4szY89ehyNlXkcQy3Y1BN66JWx3XACt4VXLCXqtUrxE1DcdM',
  },
];
---

<SiteLayout
  title="Module — проектирование и сборка систем автоматизации"
  description="Проектируем системы автоматизации, подбираем оборудование, собираем щиты, готовим сценарии на ПО Module и доставляем комплект с документацией."
>
  <section class="hero section" id="top" aria-labelledby="hero-title">
    <div class="shell hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">Module / инженерная автоматизация</p>
        <h1 id="hero-title">Проектируем и собираем системы <span>автоматизации</span></h1>
        <p class="hero-subtitle">
          Подберём оборудование, соберём щит, подготовим сценарии на <a href="/software/">ПО Module</a>{' '}
          и доставим комплект с проектом и документацией.
        </p>
        <div class="actions">
          <a class="button" href="#first-object">Обсудить проект ↗</a>
          <a class="button button--secondary" href="#result">Что входит в комплект</a>
        </div>
        <p class="hero-note">От задачи на объекте — до подготовленного комплекта для подключения.</p>
      </div>

      <figure class="package-board">
        <div class="board-heading"><span>Результат нашей работы</span><span>MODULE / KIT</span></div>
        <div class="package-parts">
          <div class="package-part">
            <span class="item-number">01 / Проект</span>
            <div class="drawing-preview" aria-hidden="true">
              <div></div><div></div><div></div><span>СХЕМА ПОДКЛЮЧЕНИЙ</span>
            </div>
            <strong>Всё связано<br />на схеме</strong>
          </div>
          <div class="package-part package-part--cabinet">
            <span class="item-number">02 / Щит</span>
            <div class="cabinet-preview" aria-hidden="true">
              {[0, 1, 2].map(() => (
                <div class="cabinet-rail">{[0, 1, 2, 3, 4, 5].map(() => <i></i>)}</div>
              ))}
            </div>
            <strong>Оборудование<br />собрано</strong>
          </div>
          <div class="package-part package-part--software">
            <span class="item-number">03 / ПО и сценарии</span>
            <div class="logic-preview" aria-hidden="true"><span>УСЛОВИЕ</span><b>↓</b><span>ДЕЙСТВИЕ</span></div>
            <strong>Логика<br />под вашу задачу</strong>
          </div>
          <div class="package-part">
            <span class="item-number">04 / Документация</span>
            <div class="document-preview" aria-hidden="true"><span>СОСТАВ</span><span>ПОДКЛЮЧЕНИЕ</span><span>НАСТРОЙКИ</span></div>
            <strong>Понятно,<br />как подключить</strong>
          </div>
        </div>
        <figcaption>Иллюстрация состава. Комплектация определяется проектом.</figcaption>
      </figure>
    </div>
  </section>

  <section class="section" id="result" aria-labelledby="result-title">
    <div class="shell">
      <p class="eyebrow">Что вы получаете</p>
      <h2 class="section-title" id="result-title">Четыре части.<br />Один согласованный комплект.</h2>
      <div class="deliverables">
        {deliverables.map((item, index) => (
          <article>
            <span class="item-number">0{index + 1}</span>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
            {index === 2 ? <a class="text-link" href="/software/">Подробнее о ПО Module ↗</a> : <small>{item.detail}</small>}
          </article>
        ))}
      </div>
      <p class="boundary-note">
        Монтаж, подключение и пусконаладку на объекте согласуем отдельно: они не включаются
        в поставку автоматически. До начала работ определяем, кто и за что отвечает.
      </p>
    </div>
  </section>

  <section class="section dark-section" id="solutions" aria-labelledby="solutions-title">
    <div class="shell">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Какие задачи решаем</p>
          <h2 class="section-title" id="solutions-title">Свет, тепло, вода и движение.</h2>
        </div>
        <a class="text-link" href="/software/#automations">Все автоматизации в ПО ↗</a>
      </div>
      <p class="lede">Начинаем с того, что должно происходить на объекте. Под задачу выбираем оборудование и настраиваем логику.</p>
      <div class="solution-list">
        {solutions.map((solution, index) => (
          <article class="solution-row">
            <span class="item-number">0{index + 1}</span>
            <h3><a href={`/software/#${solution.id}`}>{solution.title}<span aria-hidden="true"> ↗</span></a></h3>
            <div><p>{solution.text}</p><small>{solution.example}</small></div>
          </article>
        ))}
      </div>
      <div class="experience" id="proof">
        <strong>3 года</strong>
        <p>применяем автоматизации Module на практике.<br /><span>Состав функций для конкретного объекта подбираем по его задачам и оборудованию.</span></p>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="objects-title">
    <div class="shell">
      <p class="eyebrow">Где применяется</p>
      <h2 class="section-title" id="objects-title">Не только жилые помещения.</h2>
      <p class="lede">Автоматизация нужна и внутри здания, и за его пределами. Обсудим отдельный узел, помещение или несколько систем объекта.</p>
      <div class="object-grid">
        {objectGroups.map(([title, text]) => <article><h3>{title}</h3><p>{text}</p></article>)}
      </div>
      <p class="boundary-note">Двери, калитки, ворота, освещение территории — отдельные задачи внутри проекта. Состав управления и требования безопасности определяем для каждой из них.</p>
    </div>
  </section>

  <section class="section process-section" id="process" aria-labelledby="process-title">
    <div class="shell">
      <p class="eyebrow">Как проходит работа</p>
      <h2 class="section-title" id="process-title">От проекта до доставки.</h2>
      <ol class="process-list">
        {process.map(([title, text], index) => (
          <li><span class="item-number">0{index + 1}</span><h3>{title}</h3><p>{text}</p></li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section software-section" id="foundations" aria-labelledby="software-title">
    <div class="shell software-grid">
      <div>
        <p class="eyebrow">Программная основа решения</p>
        <h2 class="section-title" id="software-title">Внутри —<br />ПО Module.</h2>
      </div>
      <div>
        <p class="lede">Оборудование выполняет команды. Module связывает показания датчиков, настройки и действия в автоматизации.</p>
        <p>Для типовых задач используем готовые программные функции — макросы. Подбираем их состав и настраиваем под оборудование проекта.</p>
        <a class="button" href="/software/">Возможности ПО Module ↗</a>
      </div>
    </div>
  </section>

  <section class="section contact-section" id="first-object" aria-labelledby="contact-title">
    <div class="shell contact-grid">
      <div>
        <p class="eyebrow">Обсудим вашу задачу</p>
        <h2 class="section-title" id="contact-title">Что нужно автоматизировать?</h2>
        <p class="lede">Начать можно с плана объекта и списка пожеланий. Если уже работаете с электриком, подключите его к обсуждению проекта.</p>
      </div>
      <div class="project-checklist">
        <h3>Для первого разговора</h3>
        <ul>
          <li>Тип объекта и стадия работ.</li>
          <li>План или схема, если они есть.</li>
          <li>Что должно работать автоматически.</li>
          <li>Уже выбранное оборудование и желаемые сроки.</li>
        </ul>
        <p>Электрику поможем определить состав автоматизации; владельцу — сформулировать задачу для совместной работы.</p>
        <div class="contact-note">
          <h4>Способы связи</h4>
          <address class="contact-channels">
            {contactChannels.map((channel) => (
              <a href={channel.href}>
                <span>{channel.label} <span aria-hidden="true">↗</span></span>
                <strong>{channel.value}</strong>
              </a>
            ))}
          </address>
        </div>
      </div>
    </div>
  </section>
</SiteLayout>

<style>
  .hero-grid {
    display: grid;
    align-items: center;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.9fr);
    gap: clamp(32px, 5vw, 80px);
  }

  .hero-copy h1 {
    margin: 0;
    font-size: clamp(40px, 5.2vw, 76px);
    font-weight: 850;
    line-height: 1.02;
    letter-spacing: -0.06em;
  }

  .hero-copy h1 span {
    color: var(--accent-dark);
  }

  .hero-subtitle {
    max-width: 660px;
    margin: 28px 0 0;
    font-size: clamp(18px, 1.7vw, 24px);
    line-height: 1.5;
  }

  .hero-subtitle a {
    text-decoration-thickness: 1px;
  }

  .hero-note {
    max-width: 550px;
    margin: 24px 0 0;
    color: var(--muted);
    font-size: 13px;
    line-height: 1.6;
  }

  .package-board {
    margin: 0;
    border: 2px solid var(--ink);
    background: var(--paper-strong);
    box-shadow: 10px 10px 0 var(--ink);
  }

  .board-heading {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px;
    padding: 16px;
    border-bottom: 1px solid var(--line);
    font-family: var(--mono);
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
  }

  .package-parts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .package-part {
    display: flex;
    min-height: 224px;
    flex-direction: column;
    align-items: start;
    padding: 20px;
    border-bottom: 1px solid var(--line);
  }

  .package-part:nth-child(odd) {
    border-right: 1px solid var(--line);
  }

  .package-part strong {
    margin-top: auto;
    font-size: 21px;
    line-height: 1.15;
    letter-spacing: -0.035em;
  }

  .package-part--cabinet {
    background: #e1e3dc;
  }

  .package-part--software {
    background: var(--signal);
  }

  .drawing-preview,
  .cabinet-preview,
  .logic-preview,
  .document-preview {
    width: 100%;
    max-width: 175px;
    margin-block: 22px;
  }

  .drawing-preview {
    display: grid;
    height: 75px;
    padding: 10px;
    border: 1px solid var(--ink);
    grid-template-columns: repeat(3, 1fr);
    gap: 10px;
    background: repeating-linear-gradient(0deg, transparent 0 11px, rgb(23 24 20 / 10%) 11px 12px);
  }

  .drawing-preview div {
    border: 1px solid var(--ink);
    background: var(--paper-strong);
  }

  .drawing-preview span {
    grid-column: 1 / -1;
    font-family: var(--mono);
    font-size: 7px;
  }

  .cabinet-preview {
    display: grid;
    padding: 10px;
    border: 3px solid var(--ink);
    gap: 6px;
    background: var(--paper);
  }

  .cabinet-rail {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 3px;
  }

  .cabinet-rail i {
    height: 17px;
    border: 1px solid var(--ink);
    background: linear-gradient(var(--paper-strong) 40%, var(--ink) 40% 65%, var(--paper-strong) 65%);
  }

  .cabinet-rail:first-child i:first-child {
    grid-column: span 2;
    background: var(--accent);
  }

  .cabinet-rail:first-child i:last-child {
    display: none;
  }

  .logic-preview {
    display: grid;
    justify-items: start;
    gap: 4px;
    font-family: var(--mono);
    font-size: 10px;
  }

  .logic-preview span {
    padding: 7px 10px;
    border: 1px solid var(--ink);
  }

  .logic-preview b {
    padding-left: 40px;
  }

  .document-preview {
    display: grid;
    padding: 10px;
    border: 1px solid var(--ink);
    box-shadow: 4px 4px 0 var(--paper), 5px 5px 0 var(--ink);
    gap: 8px;
    font-family: var(--mono);
    font-size: 8px;
  }

  .document-preview span {
    padding-bottom: 4px;
    border-bottom: 1px solid var(--ink);
  }

  .package-board figcaption {
    padding: 12px 16px;
    color: var(--muted);
    font-size: 10px;
    line-height: 1.5;
  }

  .deliverables,
  .object-grid {
    display: grid;
    margin-top: 48px;
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .deliverables article {
    display: flex;
    flex-direction: column;
    padding: 24px;
    border: 1px solid var(--line);
    background: var(--paper-strong);
  }

  .deliverables article + article {
    border-left: 0;
  }

  .deliverables h3 {
    margin: 36px 0 16px;
    font-size: clamp(23px, 2.3vw, 32px);
    line-height: 1.1;
    letter-spacing: -0.035em;
  }

  .deliverables p,
  .object-grid p {
    margin: 0 0 24px;
    font-size: 16px;
    line-height: 1.5;
  }

  .deliverables small,
  .deliverables a {
    margin-top: auto;
    color: var(--muted);
    font-size: 12px;
    line-height: 1.6;
  }

  .boundary-note {
    max-width: 900px;
    margin: 28px 0 0;
    padding-left: 18px;
    border-left: 3px solid var(--accent);
    color: var(--muted);
    font-size: 14px;
    line-height: 1.6;
  }

  .solution-list {
    margin-top: 48px;
    border-top: 1px solid #64655f;
  }

  .solution-row {
    display: grid;
    padding-block: 30px;
    border-bottom: 1px solid #64655f;
    grid-template-columns: 40px minmax(0, 0.9fr) minmax(0, 1fr);
    gap: 24px;
  }

  .solution-row > span {
    color: var(--signal);
  }

  .solution-row h3 {
    margin: 0;
    font-size: clamp(24px, 2.5vw, 36px);
    line-height: 1.15;
    letter-spacing: -0.035em;
  }

  .solution-row h3 a {
    text-decoration: none;
  }

  .solution-row h3 a:hover {
    text-decoration: underline;
  }

  .solution-row h3 span {
    color: var(--signal);
  }

  .solution-row p {
    margin: 0 0 14px;
    font-size: 17px;
    line-height: 1.5;
  }

  .solution-row small,
  .experience p span {
    color: #c9cac4;
    font-size: 13px;
  }

  .experience {
    display: flex;
    align-items: center;
    gap: 40px;
    margin-top: 48px;
  }

  .experience strong {
    flex-shrink: 0;
    color: var(--signal);
    font-size: clamp(40px, 6vw, 76px);
    letter-spacing: -0.06em;
  }

  .experience p {
    margin: 0;
    font-size: 19px;
    line-height: 1.6;
  }

  .object-grid {
    gap: 28px;
  }

  .object-grid article {
    padding-top: 20px;
    border-top: 2px solid var(--ink);
  }

  .object-grid h3 {
    font-size: 14px;
  }

  .object-grid p {
    font-size: 22px;
    letter-spacing: -0.025em;
  }

  .process-section {
    background: var(--paper-strong);
  }

  .process-list {
    display: grid;
    margin: 48px 0 0;
    padding: 0;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 32px;
    list-style: none;
  }

  .process-list li {
    padding-top: 16px;
    border-top: 2px solid var(--ink);
  }

  .process-list h3 {
    margin: 24px 0 12px;
    font-size: 24px;
    letter-spacing: -0.04em;
  }

  .process-list p {
    margin: 0;
    color: var(--muted);
    font-size: 15px;
    line-height: 1.6;
  }

  .software-section {
    background: var(--signal);
  }

  .software-grid,
  .contact-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(32px, 7vw, 100px);
  }

  .software-grid .lede {
    margin-top: 0;
  }

  .software-grid p:not(.lede, .eyebrow) {
    margin: 24px 0 32px;
    line-height: 1.6;
  }

  .contact-section {
    color: var(--paper-strong);
    background: var(--accent-dark);
  }

  .contact-section .eyebrow::before {
    background: var(--signal);
  }

  .project-checklist {
    padding: clamp(20px, 3vw, 40px);
    border: 1px solid currentColor;
  }

  .project-checklist h3 {
    margin: 0 0 24px;
    font-size: 23px;
  }

  .project-checklist ul {
    padding-left: 20px;
    line-height: 1.7;
  }

  .project-checklist p {
    font-size: 14px;
    line-height: 1.6;
  }

  .contact-note {
    margin: 24px 0 0;
    padding-top: 20px;
    border-top: 1px solid currentColor;
  }

  .contact-note h4 {
    margin: 0 0 16px;
    font-size: 16px;
  }

  .contact-channels {
    display: grid;
    gap: 10px;
    font-size: 14px;
    font-style: normal;
  }

  .contact-channels a {
    display: grid;
