---
import { Image } from 'astro:assets';
import SiteLayout from '../layouts/site-layout.astro';
import ContactChannels from '../components/contact-channels.astro';
import AutomationDocsLinks from '../components/automation-docs-links.astro';
import HomeAutomationScene from '../components/home-automation-scene.astro';
import { automationGroups } from '../data/automation-catalog';
import '../styles/commercial-content.css';

const deliverables = [
  { title: 'Проект', text: 'Требования, подобранное оборудование, смета и чертёж щита под задачи вашего объекта.' },
  { title: 'Собранный щит', text: 'Закупленные компоненты и оборудование, собранное по согласованному проекту.' },
  { title: 'ПО и автоматизации', text: 'Module и подготовленные сценарии для света, климата, воды и приводов.' },
  { title: 'Документация', text: 'Проект, баланс нагрузок и кабельный журнал для подключения и дальнейшей работы.' },
];

const process = [
  ['Обсуждаем и проектируем', 'Разбираемся в задачах, подбираем оборудование, готовим проект и согласуем стоимость.'],
  ['Комплектуем и собираем', 'Закупаем согласованные компоненты и собираем щит автоматизации.'],
  ['Готовим и проверяем', 'Настраиваем автоматизации и проверяем все согласованные сценарии в лаборатории.'],
  ['Передаём комплект', 'Доставляем щит с проектом и документами. Подключение и запуск на объекте согласуем отдельно.'],
];
---

<SiteLayout
  title="Module — проектирование и сборка систем автоматизации"
  description="Автоматизация света, климата, воды и приводов. Проектируем систему под ваш объект, собираем щит и готовим сценарии на ПО Module."
>
  <section class="section commercial-hero" id="top" aria-labelledby="hero-title">
    <div class="shell overview-grid">
      <div class="overview-copy">
        <p class="eyebrow">Module / инженерная автоматизация</p>
        <h1 id="hero-title">Проектируем и собираем системы <span>автоматизации</span></h1>
        <p class="hero-lede">Свет встречает вас. Температура поддерживается. Шторы учитывают солнце.</p>
        <p class="hero-explanation">Подберём оборудование для вашего объекта, соберём щит и подготовим нужные автоматизации.</p>
      </div>
      <HomeAutomationScene />
      <div class="actions overview-actions">
        <a class="button" href="#solutions">Что сможет ваша система ↓</a>
        <a class="button button--secondary" href="#contacts">Обсудить проект ↗</a>
      </div>
    </div>
  </section>

  <section class="section dark-section" id="solutions" aria-labelledby="solutions-title">
    <div class="shell">
      <div class="section-heading">
        <div><p class="eyebrow">Узнайте свою задачу</p><h2 class="section-title" id="solutions-title">Что можно поручить автоматике.</h2></div>
        <a class="text-link" href="/ru/docs/">Все возможности Module ↗</a>
      </div>
      <div class="visual-catalog home-catalog">
        {automationGroups.map((group) => (
          <article class="visual-card">
            <div class="visual-card-media">
              <Image src={group.automations[0].image} alt={group.automations[0].alt}
                widths={[360, 640, 960]} sizes="(max-width: 650px) 92vw, (max-width: 1100px) 45vw, 30vw" format="webp" loading="lazy" />
            </div>
            <div class="visual-card-copy">
              <p class="card-category">{group.title}</p>
              <h3>{group.result}</h3>
              <p>{group.description}</p>
              <AutomationDocsLinks group={group.id} />
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section" id="result" aria-labelledby="result-title">
    <div class="shell">
      <p class="eyebrow">Что вы получаете</p>
      <h2 class="section-title" id="result-title">Комплект для вас и вашего электрика.</h2>
      <p class="lede">От согласованной задачи до оборудования, программы и понятных документов для подключения.</p>
      <div class="delivery-grid">
        {deliverables.map((item, index) => (
          <article><span class="item-number">0{index + 1}</span><h3>{item.title}</h3><p>{item.text}</p></article>
        ))}
      </div>
      <p class="boundary-note">После сборки проверяем согласованные сценарии в лаборатории. Часть пусконаладки автоматизирует само ПО Module. Монтаж, подключение и пусконаладку на объекте согласуем отдельно — до начала работ определяем, кто и за что отвечает.</p>
    </div>
  </section>

  <section class="section process-section" id="process" aria-labelledby="process-title">
    <div class="shell">
      <p class="eyebrow">Как проходит работа</p>
      <h2 class="section-title" id="process-title">От идеи до готового комплекта.</h2>
      <ol class="process-list">
        {process.map(([title, text], index) => (
          <li><span class="item-number">0{index + 1}</span><h3>{title}</h3><p>{text}</p></li>
        ))}
      </ol>
      <div class="object-scope">
        <h3>Для дома, работы и территории</h3>
        <p>Квартиры и дома, гаражи и хозяйственные постройки, склады, кафе, участки и парки. Можно начать с отдельной задачи и подобрать состав системы под объект.</p>
        <p class="boundary-note">Для ворот, дверей и других движущихся механизмов отдельно определяем требования безопасности и защиту.</p>
      </div>
    </div>
  </section>

  <section class="section software-section" id="foundations" aria-labelledby="software-title">
    <div class="shell information-grid">
      <div><p class="eyebrow">Программная основа решения</p><h2 class="section-title" id="software-title">Оборудование действует.<br />Module связывает всё вместе.</h2></div>
      <div class="information-copy">
        <p class="lede">Показания датчиков превращаются в действия: включить свет, подать тепло или открыть шторы.</p>
        <p>Для типовых задач используем готовые автоматизации. Выбираем нужные функции и настраиваем их под оборудование и условия вашего проекта.</p>
        <a class="button" href="/software/">Посмотреть, как работает Module ↗</a>
      </div>
    </div>
  </section>

  <section class="section contact-section" id="first-object" aria-labelledby="contacts">
    <div class="shell contact-grid">
      <div>
        <p class="eyebrow">Контакты</p>
        <h2 class="section-title" id="contacts">Что нужно автоматизировать?</h2>
        <p class="lede">Напишите или позвоните. Начать можно с описания задачи — готовый проект для обращения не нужен.</p>
        <ContactChannels label="Связаться по поводу проекта" emailSubject="Проект автоматизации Module" />
      </div>
      <div class="project-checklist">
        <h3>Для первого разговора</h3>
        <p>Если информация уже есть, она поможет нам быстрее разобраться в задаче:</p>
        <ul>
          <li>Тип объекта и стадия работ.</li>
          <li>План или схема, если они есть.</li>
          <li>Что должно работать автоматически.</li>
          <li>Уже выбранное оборудование и желаемые сроки.</li>
        </ul>
        <p>Электрику поможем определить состав автоматизации; владельцу — сформулировать задачу для совместной работы.</p>
        <p>Если уже работаете с электриком, можно подключить его к разговору. Собирать весь список заранее необязательно.</p>
      </div>
    </div>
  </section>
</SiteLayout>
