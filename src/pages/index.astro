---
import '../styles/global.css';

const solutions = [
  {
    number: '01',
    title: 'Защита от протечки',
    result: 'Заметить протечку и дать крану команду перекрыть воду.',
    dependency: 'Перед запуском проверим датчики, кран и схему водоснабжения.',
  },
  {
    number: '02',
    title: 'Свет по условиям',
    result: 'Включать и выключать свет по кнопкам, движению, освещённости и времени.',
    dependency: 'Определим, какие кнопки, датчики и группы света есть в доме.',
  },
  {
    number: '03',
    title: 'Климат по режимам',
    result: 'Поддерживать нужную температуру по датчикам, расписанию и выбранному режиму.',
    dependency: 'Учтём котёл, смесительные узлы, тёплые полы и приводы конкретного дома.',
  },
  {
    number: '04',
    title: 'Шторы по солнцу и времени',
    result: 'Открывать и закрывать шторы по кнопке, солнцу и времени.',
    dependency: 'Проверим привод, крайние положения и обычное ручное управление.',
  },
  {
    number: '05',
    title: 'Рециркуляция горячей воды',
    result: 'Включать рециркуляцию, когда нужна горячая вода, и вовремя останавливать насос.',
    dependency: 'Настроим работу под конкретный насос и схему водоснабжения.',
  },
];

const foundations = [
  ['01', 'Понятно, что подключено', 'У каждого датчика, кнопки и привода есть своё назначение в доме.'],
  ['02', 'Логика не пишется заново', 'Повторяющиеся задачи собираются из готовых и проверяемых функций.'],
  ['03', 'Важное работает локально', 'Критические правила выполняются на контроллере и не передаются искусственному интеллекту.'],
  ['04', 'Проверяем до запуска', 'Сложную схему сначала собираем и проверяем на известном оборудовании.'],
  ['05', 'Видно, почему это произошло', 'Можно понять, что запустило действие и на каком месте возникла проблема.'],
  ['06', 'Изменения имеют версии', 'Настройки и программы не меняются незаметно и учитывают переход между версиями.'],
  ['07', 'Электрику не нужно программировать', 'Он назначает готовые функции и проверяет результат на объекте.'],
  ['08', 'Совместимость проверяется', 'Оборудование и ограничения уточняются до обещания результата заказчику.'],
];
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Module связывает оборудование, инженерные функции, настройку и сопровождение в одну управляемую систему автоматизации дома."
    />
    <meta name="robots" content="noindex,nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Module — инженерная автоматизация дома</title>
  </head>
  <body>
    <header class="site-header">
      <div class="shell header-inner">
        <a class="brand" href="#top" aria-label="Module — к началу страницы">
          <span class="brand-mark" aria-hidden="true">M</span>
          <span>MODULE</span>
        </a>
        <nav class="desktop-nav" aria-label="Основная навигация">
          <a href="#proof">Что уже работает</a>
          <a href="#solutions">Что можно сделать</a>
          <a href="#process">Как проходит работа</a>
          <a href="#foundations">Как всё устроено</a>
          <a href="/ru/docs/">Документация</a>
        </nav>
        <a class="header-cta" href="#first-object">Обсудить объект <span aria-hidden="true">↗</span></a>
        <details class="mobile-nav">
          <summary aria-label="Открыть меню">Меню</summary>
          <nav aria-label="Мобильная навигация">
            <a href="#proof">Что уже работает</a>
            <a href="#solutions">Что можно сделать</a>
            <a href="#process">Как проходит работа</a>
            <a href="#foundations">Как всё устроено</a>
            <a href="/ru/docs/">Документация</a>
            <a href="#first-object">Обсудить объект</a>
          </nav>
        </details>
      </div>
    </header>

    <main id="top">
      <section class="hero" aria-labelledby="hero-title">
        <div class="shell hero-grid">
          <div class="hero-copy">
            <p class="eyebrow">Автоматика для частного дома</p>
            <h1 id="hero-title">Дом, в котором понятно, что происходит</h1>
            <p class="hero-subtitle">
              Module помогает связать отопление, свет, воду, шторы и другое оборудование в одну
              систему. Вы заранее понимаете, как она будет работать и чем сможете управлять.
            </p>
            <div class="hero-actions">
              <a class="button" href="#first-object">Электрику: обсудить реальный объект</a>
              <a class="button button--secondary" href="#solutions">Посмотреть, что можно сделать</a>
            </div>
            <p class="hero-note">
              Module полезен, когда в доме должны работать вместе несколько инженерных систем. Для
              пары ламп и датчиков проще выбрать обычную бытовую автоматику.
            </p>
          </div>

          <div class="system-map" aria-label="Схема: оборудование связано с функциями и управлением">
            <div class="map-header">
              <span>Как это работает</span>
              <span class="live-dot">Локально</span>
            </div>
            <div class="map-body">
              <div class="map-node map-node--source">
                <span class="map-code">Сигнал</span>
                <strong>Датчики<br />и кнопки</strong>
                <small>Что происходит в доме</small>
              </div>
              <div class="map-arrow" aria-hidden="true">→</div>
              <div class="map-node map-node--core">
                <span class="map-code">Решение</span>
                <strong>Правила<br />работы</strong>
                <small>Что проверить и сделать</small>
              </div>
              <div class="map-arrow" aria-hidden="true">→</div>
              <div class="map-node map-node--result">
                <span class="map-code">Действие</span>
                <strong>Свет · тепло<br />вода · приводы</strong>
                <small>Что изменится в доме</small>
              </div>
            </div>
            <div class="map-console">
              <span>Сейчас</span>
              <strong>В комнате · 21 °C</strong>
              <span class="console-status">● всё в порядке</span>
            </div>
          </div>
        </div>
      </section>

      <section class="proof" id="proof" aria-labelledby="proof-title">
        <div class="shell">
          <div class="section-heading-row">
            <div>
              <p class="eyebrow">Показываем то, что уже работает</p>
              <h2 class="section-title" id="proof-title">Подключили датчик — его показания появились в нужном месте</h2>
            </div>
            <span class="status status--current">Работает сейчас</span>
          </div>

          <div class="proof-board">
            <ol class="proof-steps">
              <li><span>01</span><strong>Подключили датчик</strong><small>Он измеряет температуру</small></li>
              <li><span>02</span><strong>Указали, что он измеряет</strong><small>Температура в комнате</small></li>
              <li><span>03</span><strong>Выбрали, где это показать</strong><small>Карточка «Климат комнаты»</small></li>
              <li><span>04</span><strong>Получили понятное состояние</strong><small>Сейчас в комнате 21 °C</small></li>
            </ol>
            <div class="proof-display" aria-hidden="true">
              <div class="display-top"><span>Климат комнаты</span><span>•••</span></div>
              <div class="temperature">21<span>°C</span></div>
              <div class="temperature-meta"><span>Комфорт</span><span>Датчик · online</span></div>
              <div class="display-bars"><i></i><i></i><i></i><i></i><i></i><i></i><i></i></div>
            </div>
          </div>

          <p class="proof-boundary">
            <strong>Что именно это подтверждает.</strong> Подключённое устройство можно связать с
            нужной карточкой и показать его фактическое значение. Полную настройку всех функций,
            приёмку и возврат после неудачного изменения ещё нужно демонстрировать отдельно.
          </p>
        </div>
      </section>

      <section class="product" aria-labelledby="product-title">
        <div class="shell product-grid">
          <div>
            <p class="eyebrow">За что платит заказчик</p>
            <h2 class="section-title" id="product-title">Не за коробку.<br />Не за приложение.<br /><em>За работающую систему.</em></h2>
          </div>
          <div class="product-sequence">
            <div><span>01</span><p>Заранее известно, какое оборудование установят</p></div>
            <div><span>02</span><p>Понятно, как дом ведёт себя каждый день и при неполадке</p></div>
            <div><span>03</span><p>Владелец знает, что сможет менять самостоятельно</p></div>
            <div><span>04</span><p>Известно, кто запустит систему и кто поможет после</p></div>
          </div>
        </div>
      </section>

      <section class="solutions" id="solutions" aria-labelledby="solutions-title">
        <div class="shell">
          <p class="eyebrow">Что можно автоматизировать</p>
          <h2 class="section-title" id="solutions-title">Пять понятных задач для дома</h2>
          <p class="lede">Обсуждаем не названия сценариев, а то, что должно происходить в доме.</p>

          <div class="solution-list">
            {solutions.map((solution) => (
              <article class="solution-card">
                <div class="solution-number">{solution.number}</div>
                <div class="solution-copy">
                  <span class="status status--pilot">Пока пилот · под ваш объект</span>
                  <h3>{solution.title}</h3>
                  <p>{solution.result}</p>
                </div>
                <p class="solution-dependency">{solution.dependency}</p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="process" id="process" aria-labelledby="process-title">
        <div class="shell">
          <p class="eyebrow">Как проходит работа</p>
          <h2 class="section-title" id="process-title">Сначала договариваемся. Потом включаем.</h2>
          <div class="process-line">
            {['Понять задачу', 'Подобрать состав', 'Согласовать', 'Проверить', 'Передать дом', 'Пользоваться', 'Изменить позже'].map((step, index) => (
              <div class="process-step">
                <span>{String(index + 1).padStart(2, '0')}</span>
                <strong>{step}</strong>
              </div>
            ))}
          </div>
          <p class="process-note">
            Часть этого пути уже работает в продукте. Общий порядок повторной проверки и возврата
            после неудачного изменения ещё предстоит закончить — мы не выдаём его за готовую функцию.
          </p>
        </div>
      </section>

      <section class="roles" aria-labelledby="roles-title">
        <div class="shell">
          <p class="eyebrow">Для кого мы это делаем</p>
          <h2 class="section-title" id="roles-title">Начинаем с электрика и реального дома</h2>
          <div class="role-grid">
            <article class="role-card role-card--primary">
              <span>Основной маршрут</span>
              <h3>Электрику</h3>
              <p>Собрать сложную автоматику из понятных функций и не писать отдельную программу для каждого дома.</p>
              <a class="button" href="#first-object">Обсудить первый объект</a>
            </article>
            <article class="role-card">
              <span>Конечный заказчик</span>
              <h3>Владельцу дома</h3>
              <p>Заранее понять, что будет работать, чем можно управлять и что спросить у своего электрика.</p>
            </article>
            <article class="role-card role-card--small">
              <h3>Интегратору</h3>
              <p>Не собирать каждую похожую систему заново и проще передавать её на обслуживание.</p>
            </article>
            <article class="role-card role-card--small">
              <h3>DIY / самостройщику</h3>
              <p>Понять, что можно спокойно сделать самому, а где уже нужен инженерный подход.</p>
            </article>
            <article class="role-card role-card--small">
              <h3>Производителю</h3>
              <p>Показать, где устройство применяется и с каким оборудованием действительно работает.</p>
            </article>
          </div>
        </div>
      </section>

      <section class="evolution" aria-labelledby="evolution-title">
        <div class="shell">
          <p class="eyebrow">Что происходит после запуска</p>
          <h2 class="section-title" id="evolution-title">Дом не должен меняться сам по себе</h2>
          <div class="evolution-grid">
            <article>
              <span class="evolution-code">РАБОТАЕТ / СЕЙЧАС</span>
              <h3>То, что уже принято</h3>
              <ul>
                <li>важные правила выполняются на контроллере;</li>
                <li>используются поддержанные настройки;</li>
                <li>у конфигурации есть версия;</li>
                <li>состав конкретного дома зафиксирован.</li>
              </ul>
            </article>
            <article>
              <span class="evolution-code">ИЗМЕНЕНИЯ / ОТДЕЛЬНО</span>
              <h3>То, что меняем позже</h3>
              <ul>
                <li>владелец меняет разрешённые параметры;</li>
                <li>новые функции добавляются по запросу;</li>
                <li>обновление получает отдельную версию;</li>
                <li>изменённая часть проверяется снова.</li>
              </ul>
            </article>
          </div>
        </div>
      </section>

      <section class="foundations" id="foundations" aria-labelledby="foundations-title">
        <div class="shell">
          <p class="eyebrow">Что остаётся за красивым экраном</p>
          <h2 class="section-title" id="foundations-title">Чтобы дом можно было обслуживать</h2>
          <div class="foundation-grid">
            {foundations.map(([number, title, text]) => (
              <article>
                <span>{number}</span>
                <h3>{title}</h3>
                <p>{text}</p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="honesty" aria-labelledby="honesty-title">
        <div class="shell honesty-grid">
          <div>
            <p class="eyebrow">Честная граница</p>
            <h2 class="section-title" id="honesty-title">Когда проще обойтись без Module</h2>
          </div>
          <div class="honesty-copy">
            <p>
              Если нужно связать пару ламп, розеток и бытовых датчиков, готовая массовая система
              будет проще и дешевле.
            </p>
            <p>
              Module нужен там, где вместе работают отопление, вода, свет и приводы, а ошибку нельзя
              просто оставить владельцу со словами «разберётесь».
            </p>
          </div>
        </div>
      </section>

      <section class="first-object" id="first-object" aria-labelledby="first-object-title">
        <div class="shell first-object-grid">
          <div>
            <p class="eyebrow">Следующий шаг</p>
            <h2 id="first-object-title">Давайте разберём первый объект</h2>
          </div>
          <div>
            <p>
              Ищем электрика с реальным или ближайшим объектом, где должны работать вместе несколько
              инженерных систем. Разберём задачу, выберем границы пилота и договоримся, как проверим результат.
            </p>
            <div class="qualification">
              <span>Что стоит подготовить к разговору</span>
              <ul>
                <li>тип и стадия объекта;</li>
                <li>состав инженерных систем;</li>
                <li>планируемый контроллер и оборудование;</li>
                <li>желаемый срок запуска.</li>
              </ul>
            </div>
            <p class="channel-note">Способ связи добавим, когда определим форму и порядок работы с обращениями.</p>
          </div>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="shell footer-grid">
        <a class="brand brand--footer" href="#top"><span class="brand-mark">M</span><span>MODULE</span></a>
        <p>Понятная автоматика для частного дома.</p>
        <p><a href="/ru/docs/">Документация</a> · Непубличный прототип · 13.08.2026</p>
      </div>
    </footer>

    <script>
      document.querySelectorAll<HTMLAnchorElement>('.mobile-nav a').forEach((link) => {
        link.addEventListener('click', () => {
          link.closest('details')?.removeAttribute('open');
        });
      });
    </script>
  </body>
</html>

<style>
  .site-header {
    position: sticky;
    z-index: 20;
    top: 0;
    border-bottom: 2px solid var(--line);
    background: rgb(240 238 230 / 92%);
    backdrop-filter: blur(12px);
  }

  .header-inner {
    display: grid;
    min-height: 74px;
    align-items: center;
    grid-template-columns: auto 1fr auto;
    gap: 32px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 18px;
    font-weight: 850;
    letter-spacing: -0.03em;
    text-decoration: none;
  }

  .brand-mark {
    display: grid;
    width: 30px;
    height: 30px;
    place-items: center;
    color: var(--paper-strong);
    background: var(--ink);
    font-size: 16px;
    font-weight: 900;
  }

  .desktop-nav {
    display: flex;
    justify-content: center;
    gap: clamp(18px, 2.5vw, 38px);
  }

  .desktop-nav a,
  .header-cta {
    font-size: 14px;
    font-weight: 700;
    text-decoration: none;
  }

  .desktop-nav a:hover,
  .header-cta:hover {
    color: var(--accent-dark);
  }

  .header-cta {
    display: flex;
    gap: 12px;
    align-items: center;
  }

  .mobile-nav {
    display: none;
  }

  .hero {
    min-height: calc(100svh - 74px);
    border-bottom: 2px solid var(--line);
  }

  .hero-grid {
    display: grid;
    min-height: calc(100svh - 74px);
    align-items: center;
    padding-block: clamp(60px, 9vw, 124px);
    grid-template-columns: minmax(0, 1.15fr) minmax(390px, 0.85fr);
    gap: clamp(48px, 8vw, 120px);
  }

  .hero-copy h1 {
    max-width: 920px;
    margin: 0;
    font-size: clamp(56px, 7.3vw, 116px);
    font-weight: 850;
    line-height: 0.89;
    letter-spacing: -0.068em;
  }

  .hero-subtitle {
    max-width: 740px;
    margin: 36px 0 0;
    font-size: clamp(20px, 2vw, 29px);
    line-height: 1.35;
    letter-spacing: -0.025em;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 40px;
  }

  .hero-note {
    max-width: 720px;
    margin: 28px 0 0;
    padding-left: 18px;
    border-left: 3px solid var(--accent);
    color: var(--muted);
    font-size: 14px;
    line-height: 1.5;
  }

  .system-map {
    border: 2px solid var(--line);
    background: var(--paper-strong);
    box-shadow: 14px 14px 0 var(--ink);
  }

  .map-header,
  .map-console {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px 16px;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .map-header {
    border-bottom: 2px solid var(--line);
  }

  .live-dot::before {
    display: inline-block;
    width: 8px;
    height: 8px;
    margin-right: 7px;
    border-radius: 50%;
    background: #58bb16;
    content: "";
  }

  .map-body {
    display: grid;
    padding: 22px;
    align-items: stretch;
    grid-template-columns: 1fr auto 1fr auto 1fr;
    gap: 8px;
  }

  .map-node {
    display: flex;
    min-height: 190px;
    flex-direction: column;
    justify-content: space-between;
    padding: 16px;
    border: 1px solid var(--line);
  }

  .map-node--core {
    color: var(--paper-strong);
    background: var(--ink);
  }

  .map-node--result {
    background: #ffd8cc;
  }

  .map-code,
  .map-node small {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 10px;
    line-height: 1.35;
  }

  .map-node strong {
    font-size: clamp(15px, 1.3vw, 20px);
    line-height: 1.15;
  }

