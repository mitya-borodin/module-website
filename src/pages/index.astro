---
import SiteLayout from '../layouts/site-layout.astro';
import ContactChannels from '../components/contact-channels.astro';
import SoftwareApproaches from '../components/software-approaches.astro';

const deliverables = [
  { title: 'Проект', text: 'Сбор требований, подбор оборудования, смета и чертёж щита под задачи вашего объекта.' },
  { title: 'Щит', text: 'Закупленные компоненты и собранный щит автоматизации под ваш проект.' },
  { title: 'ПО и сценарии', text: 'Module и подготовленные автоматизации для согласованных задач: света, тепла, воды и приводов.' },
  { title: 'Документация', text: 'Проект, баланс нагрузок и кабельный журнал — согласованный комплект документов по вашему объекту.' },
];

const solutions = [
  { id: 'lighting', title: 'Освещение', text: 'Свет включается по движению, когда темно, или по нажатию кнопки. Выбираем, когда его выключать; датчик шума может продлить время работы, но сам шум свет не включает.', example: 'Светильники · светодиодные ленты · разные зоны' },
  { id: 'heating', title: 'Отопление, вентиляция и кондиционирование', text: 'Вы задаёте нужную температуру, а Module управляет подходящим оборудованием для обогрева или охлаждения. Для отопления и подогрева воздуха согласуем работу котла, насосов и клапанов.', example: 'Помещения · тёплый пол · подогрев воздуха' },
  { id: 'leaks', title: 'Защита от утечек', text: 'Если датчик обнаружит утечку, Module передаст крану или клапану команду перекрыть подачу. Подбираем оборудование для воды, газа или другого вещества с учётом требований безопасности.', example: 'Вода · газ · другие вещества с подходящим датчиком' },
  { id: 'recirculation', title: 'Горячая вода', text: 'Сокращаем ожидание горячей воды у крана: насос запускается по необходимости, а не работает постоянно. Если позволяет схема, бойлер нагревается одновременно с подогревом воздуха для вентиляции.', example: 'Краны · бойлер · подогрев воздуха' },
  { id: 'drives', title: 'Шторы и приводы', text: 'Шторы открываются и закрываются по вашей команде или заданным условиям. Можно управлять и подходящими воротами, кранами и вентиляционными заслонками — возможности и защиту проверяем по оборудованию.', example: 'Окна · въезд · подача воды и воздуха' },
  { id: 'metering', title: 'Учёт ресурсов', text: 'Смотрите показания подключённых счётчиков в Module и используйте их в других автоматизациях. Подходящий способ подключения и доступные показания проверяем по модели прибора.', example: 'Сколько израсходовано · какой расход сейчас' },
];

const process = [
  ['Проектируем', 'Уточняем задачи и составляем проект автоматизации.'],
  ['Подбираем', 'Определяем контроллер, датчики и исполнительные устройства.'],
  ['Считаем', 'Согласовываем состав, стоимость и границы поставки.'],
  ['Закупаем', 'Комплектуем решение согласованным оборудованием.'],
  ['Собираем', 'Собираем щит, подготавливаем ПО и проверяем все согласованные сценарии в лаборатории.'],
  ['Документируем', 'Описываем подключения, настройки и состав комплекта.'],
  ['Доставляем', 'Передаём заказчику оборудование и документацию.'],
];

const objectGroups = [
  ['Жилые', 'Квартиры и дома'],
  ['Хозяйственные', 'Гаражи, сараи и другие постройки'],
  ['Коммерческие', 'Склады, кафе и рестораны'],
  ['Открытые территории', 'Участки и парки'],
];

---

<SiteLayout
  title="Module — проектирование и сборка систем автоматизации"
  description="Проектируем системы автоматизации, подбираем оборудование, собираем щиты, готовим сценарии на ПО Module и доставляем комплект с документацией."
>
  <section class="hero section" id="top" aria-labelledby="hero-title">
    <div class="shell hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">Module / инженерная автоматизация</p>
        <h1 id="hero-title">Проектируем и собираем системы <span>автоматизации</span></h1>
        <p class="hero-subtitle">
          Подберём оборудование, соберём щит, подготовим сценарии на <a href="/software/">ПО Module</a>{' '}
          и доставим комплект с проектом и документацией.
        </p>
        <div class="actions">
          <a class="button" href="#contacts">Обсудить проект ↗</a>
          <a class="button button--secondary" href="#result">Что входит в комплект</a>
        </div>
        <p class="hero-note">От задачи на объекте — до подготовленного комплекта для подключения.</p>
      </div>

      <figure class="package-board">
        <div class="board-heading"><span>Результат нашей работы</span><span>MODULE / KIT</span></div>
        <div class="package-parts">
          <div class="package-part">
            <span class="item-number">01 / Проект</span>
            <div class="drawing-preview" aria-hidden="true">
              <span>СБОР ТРЕБОВАНИЙ</span>
              <span>ПОДБОР ОБОРУДОВАНИЯ</span>
              <span>СМЕТА</span>
              <span>ЧЕРТЁЖ ЩИТА</span>
            </div>
            <strong>Всё связано<br />на схеме</strong>
          </div>
          <div class="package-part package-part--cabinet">
            <span class="item-number">02 / Щит</span>
            <div class="cabinet-preview" aria-hidden="true">
              {[0, 1, 2].map(() => (
                <div class="cabinet-rail">{[0, 1, 2, 3, 4, 5].map(() => <i></i>)}</div>
              ))}
            </div>
            <strong>Оборудование<br />собрано</strong>
          </div>
          <div class="package-part package-part--software">
            <span class="item-number">03 / ПО и сценарии</span>
            <svg
              class="logic-preview"
              viewBox="0 0 200 124"
              role="img"
              aria-labelledby="logic-preview-title logic-preview-description"
              focusable="false"
            >
              <title id="logic-preview-title">Входы, функциональные блоки и выходы</title>
              <desc id="logic-preview-description">
                Условный пример: входы x1 и x2 соединены с блоком И, его результат — выход y1.
                Этот результат и вход x3 соединены с блоком ИЛИ, его результат — выход y2.
              </desc>
              <defs>
                <marker
                  id="logic-preview-arrow"
                  viewBox="0 0 5 6"
                  refX="5"
                  refY="3"
                  markerWidth="5"
                  markerHeight="6"
                  orient="auto"
                  markerUnits="userSpaceOnUse"
                >
                  <path d="M0 0 L5 3 L0 6" fill="none" stroke="currentColor" />
                </marker>
              </defs>
              <g class="logic-wires" marker-end="url(#logic-preview-arrow)">
                <path d="M35 17 H70" />
                <path d="M35 55 H70" />
                <path d="M35 104 H70" />
                <path d="M124 34 H164" />
                <path d="M144 34 V73 H55 V94 H70" />
                <path d="M124 102 H164" />
              </g>
              <circle cx="144" cy="34" r="2" fill="currentColor" />
              <g class="logic-nodes">
                <rect x="1" y="4" width="34" height="26" />
                <rect x="1" y="42" width="34" height="26" />
                <rect x="1" y="91" width="34" height="26" />
                <rect x="70" y="5" width="54" height="58" />
                <rect x="70" y="78" width="54" height="44" />
                <rect x="164" y="21" width="35" height="26" />
                <rect x="164" y="89" width="35" height="26" />
              </g>
              <g class="logic-labels">
                <text x="18" y="22">x₁</text>
                <text x="18" y="60">x₂</text>
                <text x="18" y="109">x₃</text>
                <text x="182" y="39">y₁</text>
                <text x="182" y="107">y₂</text>
                <text class="logic-block-id" x="97" y="24">F₁</text>
                <text class="logic-operation" x="97" y="48">&amp;</text>
                <text class="logic-block-id" x="97" y="92">F₂</text>
                <text class="logic-operation" x="97" y="116">≥1</text>
              </g>
            </svg>
            <strong>Логика<br />под вашу задачу</strong>
          </div>
          <div class="package-part">
            <span class="item-number">04 / Документация</span>
            <div class="document-preview" aria-hidden="true"><span>ПРОЕКТ</span><span>БАЛАНС НАГРУЗОК</span><span>КАБЕЛЬНЫЙ ЖУРНАЛ</span></div>
            <strong>Понятно,<br />как подключить</strong>
          </div>
        </div>
        <figcaption>Иллюстрация состава. Комплектация определяется проектом.</figcaption>
      </figure>
    </div>
  </section>

  <section class="section" id="result" aria-labelledby="result-title">
    <div class="shell">
      <p class="eyebrow">Что вы получаете</p>
      <h2 class="section-title" id="result-title">Что входит в поставку.</h2>
      <div class="deliverables">
        {deliverables.map((item, index) => (
          <article>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
            {index === 2 && <a class="text-link" href="/software/">Подробнее о ПО Module ↗</a>}
          </article>
        ))}
      </div>
      <p class="boundary-note">
        После сборки щита проверяем все согласованные сценарии в лаборатории.
        Часть пусконаладки автоматизирует само ПО Module.
        Монтаж, подключение и пусконаладку на объекте согласуем отдельно: они не включаются
        в поставку автоматически. До начала работ определяем, кто и за что отвечает.
      </p>
    </div>
  </section>

  <section class="section dark-section" id="solutions" aria-labelledby="solutions-title">
    <div class="shell">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Какие задачи решаем</p>
          <h2 class="section-title" id="solutions-title">Свет, тепло, вода и движение.</h2>
        </div>
        <a class="text-link" href="/software/#automations">Все автоматизации в Module ↗</a>
      </div>
      <p class="lede">Начинаем с того, что должно происходить на объекте. Под задачу выбираем оборудование и настраиваем логику.</p>
      <div class="solution-list">
        {solutions.map((solution, index) => (
          <article class="solution-row">
            <span class="item-number">0{index + 1}</span>
            <h3><a href={`/software/#${solution.id}`}>{solution.title}<span aria-hidden="true"> ↗</span></a></h3>
            <div><p>{solution.text}</p><small>{solution.example}</small></div>
          </article>
        ))}
      </div>
      <div class="experience" id="proof">
        <strong>3 года</strong>
        <p>применяем автоматизации Module на практике.<br /><span>Состав функций для конкретного объекта подбираем по его задачам и оборудованию.</span></p>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="objects-title">
    <div class="shell">
      <p class="eyebrow">Где применяется</p>
      <h2 class="section-title" id="objects-title">Не только жилые помещения.</h2>
      <p class="lede">Автоматизация нужна и внутри здания, и за его пределами. Можно автоматизировать отдельное устройство, помещение или несколько систем на объекте.</p>
      <div class="object-grid">
        {objectGroups.map(([title, text]) => <article><h3>{title}</h3><p>{text}</p></article>)}
      </div>
      <p class="boundary-note">Двери, калитки, ворота, освещение территории — отдельные задачи внутри проекта. Состав управления и требования безопасности определяем для каждой из них.</p>
    </div>
  </section>

  <section class="section process-section" id="process" aria-labelledby="process-title">
    <div class="shell">
      <p class="eyebrow">Как проходит работа</p>
      <h2 class="section-title" id="process-title">От проекта до доставки.</h2>
      <ol class="process-list">
        {process.map(([title, text], index) => (
          <li><span class="item-number">0{index + 1}</span><h3>{title}</h3><p>{text}</p></li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section software-section" id="foundations" aria-labelledby="software-title">
    <div class="shell software-grid">
      <div>
        <p class="eyebrow">Программная основа решения</p>
        <h2 class="section-title" id="software-title">Внутри —<br />ПО Module.</h2>
      </div>
      <div>
        <p class="lede">Оборудование выполняет команды. Module связывает показания датчиков, настройки и действия в автоматизации.</p>
        <p>Для типовых задач используем готовые программные функции — макросы. Подбираем их состав и настраиваем под оборудование проекта.</p>
        <a class="button" href="/software/">Возможности ПО Module ↗</a>
      </div>
    </div>
  </section>

  <SoftwareApproaches audience="service" />

  <section class="section contact-section" id="first-object" aria-labelledby="contacts">
    <div class="shell contact-grid">
      <div>
        <p class="eyebrow">Контакты</p>
        <h2 class="section-title" id="contacts">Что нужно автоматизировать?</h2>
        <p class="lede">Напишите или позвоните. Начать можно с описания задачи — готовый проект для обращения не нужен.</p>
        <ContactChannels label="Связаться по поводу проекта" emailSubject="Проект автоматизации Module" />
      </div>
      <div class="project-checklist">
        <h3>Для первого разговора</h3>
        <p>Если информация уже есть, она поможет нам быстрее разобраться в задаче:</p>
        <ul>
          <li>Тип объекта и стадия работ.</li>
          <li>План или схема, если они есть.</li>
          <li>Что должно работать автоматически.</li>
          <li>Уже выбранное оборудование и желаемые сроки.</li>
        </ul>
        <p>Электрику поможем определить состав автоматизации; владельцу — сформулировать задачу для совместной работы.</p>
        <p>Если уже работаете с электриком, можно подключить его к разговору. Собирать весь список заранее необязательно.</p>
      </div>
    </div>
  </section>
</SiteLayout>

<style>
  .hero-grid {
    display: grid;
    align-items: center;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.9fr);
    gap: clamp(32px, 5vw, 80px);
  }

  .hero-copy h1 {
    margin: 0;
    font-size: clamp(40px, 5.2vw, 76px);
    font-weight: 850;
    line-height: 1.02;
    letter-spacing: -0.06em;
  }

  .hero-copy h1 span {
    color: var(--accent-dark);
  }

  .hero-subtitle {
    max-width: 660px;
    margin: 28px 0 0;
    font-size: clamp(18px, 1.7vw, 24px);
    line-height: 1.5;
  }

  .hero-subtitle a {
    text-decoration-thickness: 1px;
  }

  .hero-note {
    max-width: 550px;
    margin: 24px 0 0;
    color: var(--muted);
    font-size: 13px;
    line-height: 1.6;
  }

  .package-board {
    margin: 0;
    border: 2px solid var(--ink);
    background: var(--paper-strong);
    box-shadow: 10px 10px 0 var(--ink);
  }

  .board-heading {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px;
    padding: 16px;
    border-bottom: 1px solid var(--line);
    font-family: var(--mono);
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
  }

  .package-parts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .package-part {
    display: flex;
    min-height: 224px;
    flex-direction: column;
    align-items: start;
    padding: 20px;
    border-bottom: 1px solid var(--line);
  }

  .package-part:nth-child(odd) {
    border-right: 1px solid var(--line);
  }

  .package-part strong {
    margin-top: auto;
    font-size: 21px;
    line-height: 1.15;
    letter-spacing: -0.035em;
  }

  .package-part--cabinet {
    background: #e1e3dc;
  }

  .package-part--software {
    background: var(--signal);
  }

  .drawing-preview,
  .cabinet-preview,
  .logic-preview,
  .document-preview {
    width: 100%;
    max-width: 175px;
    margin-block: 22px;
  }

  .drawing-preview {
    display: grid;
    padding: 10px;
    border: 1px solid var(--ink);
    gap: 6px;
    font-family: var(--mono);
    font-size: 8px;
    line-height: 1.5;
  }

  .drawing-preview span {
    padding-bottom: 3px;
    border-bottom: 1px solid var(--ink);
  }

  .cabinet-preview {
    display: grid;
    padding: 10px;
    border: 3px solid var(--ink);
    gap: 6px;
    background: var(--paper);
  }

  .cabinet-rail {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 3px;
  }

  .cabinet-rail i {
    height: 17px;
    border: 1px solid var(--ink);
    background: linear-gradient(var(--paper-strong) 40%, var(--ink) 40% 65%, var(--paper-strong) 65%);
  }

  .cabinet-rail:first-child i:first-child {
    grid-column: span 2;
    background: var(--accent);
  }

  .cabinet-rail:first-child i:last-child {
    display: none;
  }

  .logic-preview {
    display: block;
    height: auto;
    margin-block: 18px;
    overflow: visible;
    font-family: var(--mono);
  }

  .logic-wires,
  .logic-nodes {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.25px;
  }

  .logic-labels {
    fill: currentColor;
    font-size: 16px;
    text-anchor: middle;
  }

  .logic-block-id {
    font-size: 14px;
  }

  .logic-operation {
    font-size: 19px;
  }

  .document-preview {
    display: grid;
    padding: 10px;
    border: 1px solid var(--ink);
    box-shadow: 4px 4px 0 var(--paper), 5px 5px 0 var(--ink);
    gap: 8px;
    font-family: var(--mono);
    font-size: 8px;
  }

  .document-preview span {
    padding-bottom: 4px;
    border-bottom: 1px solid var(--ink);
  }

  .package-board figcaption {
    padding: 12px 16px;
    color: var(--muted);
    font-size: 10px;
    line-height: 1.5;
  }

  .deliverables,
  .object-grid {
    display: grid;
    margin-top: 48px;
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .deliverables article {
    display: flex;
    flex-direction: column;
    padding: 24px;
    border: 1px solid var(--line);
    background: var(--paper-strong);
  }

  .deliverables article + article {
    border-left: 0;
  }

  .deliverables h3 {
    margin: 0 0 16px;
    font-size: clamp(23px, 2.3vw, 32px);
    line-height: 1.1;
    letter-spacing: -0.035em;
  }

  .deliverables p,
  .object-grid p {
    margin: 0 0 24px;
    font-size: 16px;
    line-height: 1.5;
  }

  .deliverables a {
    margin-top: auto;
    color: var(--muted);
    font-size: 12px;
    line-height: 1.6;
  }

  .boundary-note {
    max-width: 900px;
    margin: 28px 0 0;
    padding-left: 18px;
    border-left: 3px solid var(--accent);
    color: var(--muted);
    font-size: 14px;
    line-height: 1.6;
  }

  .solution-list {
    margin-top: 48px;
    border-top: 1px solid #64655f;
  }

  .solution-row {
    display: grid;
    padding-block: 30px;
    border-bottom: 1px solid #64655f;
    grid-template-columns: 40px minmax(0, 0.9fr) minmax(0, 1fr);
    gap: 24px;
  }

  .solution-row > span {
    color: var(--signal);
  }

  .solution-row h3 {
    margin: 0;
    font-size: clamp(24px, 2.5vw, 36px);
    line-height: 1.15;
    letter-spacing: -0.035em;
  }

  .solution-row h3 a {
    text-decoration: none;
  }

  .solution-row h3 a:hover {
    text-decoration: underline;
  }

  .solution-row h3 span {
    color: var(--signal);
  }

  .solution-row p {
    margin: 0 0 14px;
    font-size: 17px;
    line-height: 1.5;
  }

  .solution-row small,
  .experience p span {
    color: #c9cac4;
    font-size: 13px;
  }

  .experience {
    display: flex;
    align-items: center;
    gap: 40px;
    margin-top: 48px;
  }

  .experience strong {
    flex-shrink: 0;
    color: var(--signal);
