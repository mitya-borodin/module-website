---
import SiteLayout from '../layouts/site-layout.astro';
import ContactChannels from '../components/contact-channels.astro';
import AutomationDocsLinks from '../components/automation-docs-links.astro';
import ServiceOverview from '../components/service-overview.astro';
import { automationGroups } from '../data/automation-catalog';
import '../styles/commercial-content.css';

const deliverables = [
  { title: 'Проект', text: 'Требования, подобранное оборудование, смета и чертёж щита под задачи вашего объекта.' },
  { title: 'Собранный щит', text: 'Закупленные компоненты и оборудование, собранное по согласованному проекту.' },
  { title: 'ПО и автоматизации', text: 'Ritmod и подготовленные сценарии под задачи вашего объекта.' },
  { title: 'Документация', text: 'Проект, баланс нагрузок и кабельный журнал для подключения и дальнейшей работы.' },
];

const process = [
  ['Обсуждаем и проектируем', 'Разбираемся в задачах, подбираем оборудование, готовим проект и согласуем стоимость.'],
  ['Комплектуем и собираем', 'Закупаем согласованные компоненты. Монтажник собирает щит по проекту.'],
  ['Готовим и проверяем', 'Настраиваем автоматизации и проверяем согласованные сценарии в лаборатории. Часть пусконаладки автоматизирует ПО Ritmod.'],
  ['Принимаем монтаж', 'Мы или наш представитель проверяем наличие и маркировку всех линий, прозваниваем их и проверяем целостность изоляции. Только после успешной приёмки отправляем щит с проектом и документами на монтаж.'],
];
---

<SiteLayout
  title="Ritmod — проектирование и сборка систем автоматизации"
  description="Проект, оборудование, собранный щит, ПО Ritmod и документация под задачи вашего объекта. Согласуем состав системы, проверим сценарии в лаборатории и передадим комплект."
>
  <section class="section commercial-hero" id="top" aria-labelledby="hero-title">
    <div class="shell">
      <div class="service-intro">
        <div class="service-copy">
          <p class="eyebrow">Ritmod / проектирование и сборка</p>
          <h1 id="hero-title">Автоматизация объекта — <span>от проекта до готового щита.</span></h1>
          <p class="hero-lede">Вы получаете проект, собранный щит, подготовленные автоматизации и документы для подключения.</p>
          <p class="hero-explanation">Согласуем, как должны работать свет, климат и другие системы. Подберём оборудование и проверим сценарии в лаборатории.</p>
          <div class="actions service-actions">
            <a class="button" href="#contacts">Обсудить свой объект ↗</a>
            <a class="button button--secondary" href="#result">Что входит в комплект ↓</a>
            <a class="text-link service-software-link" href="/software/">Возможности ПО Ritmod ↗</a>
          </div>
        </div>
        <ServiceOverview />
      </div>
    </div>
  </section>

  <section class="section dark-section" id="result" aria-labelledby="result-title">
    <div class="shell">
      <p class="eyebrow">Что вы получаете</p>
      <h2 class="section-title" id="result-title">Комплект для вас и вашего электрика.</h2>
      <p class="lede">Проект, собранный щит, ПО с автоматизациями и документация входят в каждый комплект. Их наполнение зависит от задач вашего объекта.</p>
      <div class="delivery-grid">
        {deliverables.map((item, index) => (
          <article><span class="item-number">0{index + 1}</span><h3>{item.title}</h3><p>{item.text}</p></article>
        ))}
      </div>
      <p class="boundary-note">Мы отвечаем за ПО Ritmod и документацию, задаём критерии приёмки. Монтажник отвечает за сборку и монтаж по проекту. До отправки комплекта приёмку кабельного монтажа проводим мы или наш представитель.</p>
    </div>
  </section>

  <section class="section process-section" id="process" aria-labelledby="process-title">
    <div class="shell">
      <p class="eyebrow">Как проходит работа</p>
      <h2 class="section-title" id="process-title">От идеи до готового комплекта.</h2>
      <ol class="process-list">
        {process.map(([title, text], index) => (
          <li><span class="item-number">0{index + 1}</span><h3>{title}</h3><p>{text}</p></li>
        ))}
      </ol>
      <div class="object-scope">
        <h3>Для дома, работы и территории</h3>
        <p>Квартиры и дома, гаражи и хозяйственные постройки, склады, кафе, участки и парки. Можно начать с отдельной задачи и подобрать состав системы под объект.</p>
        <p class="boundary-note">Для ворот, дверей и других движущихся механизмов отдельно определяем требования безопасности и защиту.</p>
      </div>
    </div>
  </section>

  <section class="section" id="solutions" aria-labelledby="solutions-title">
    <div class="shell">
      <div class="section-heading">
        <div><p class="eyebrow">Задачи вашего объекта</p><h2 class="section-title" id="solutions-title">Что включим в проект.</h2></div>
        <a class="text-link" href="/software/#automations">Все автоматизации Ritmod ↗</a>
      </div>
      <p class="lede">Расскажите, что хотите автоматизировать, — мы подберём оборудование и определим состав щита. Подробные сценарии доступны в описаниях.</p>
      <div class="project-tasks">
        {automationGroups.map((group) => (
          <article>
            <h3>{group.title}</h3>
            <p>{group.result}.</p>
            <AutomationDocsLinks group={group.id} />
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section software-section" id="foundations" aria-labelledby="software-title">
    <div class="shell information-grid">
      <div><p class="eyebrow">Программная основа решения</p><h2 class="section-title" id="software-title">В основе комплекта —<br />ПО Ritmod.</h2></div>
      <div class="information-copy">
        <p class="lede">Программа управляет светом, климатом, водой и приводами. Для вашего проекта подготавливаем нужные автоматизации.</p>
        <p>У Ritmod есть отдельный каталог возможностей и управление из браузера. ПО можно приобрести и отдельно — после проверки задач и оборудования.</p>
        <a class="button" href="/software/">Возможности ПО Ritmod ↗</a>
      </div>
    </div>
  </section>

  <section class="section contact-section" id="first-object" aria-labelledby="contacts">
    <div class="shell contact-grid">
      <div>
        <p class="eyebrow">Контакты</p>
        <h2 class="section-title" id="contacts">Обсудим ваш объект.</h2>
        <p class="lede">Напишите или позвоните. Начать можно с описания задачи — готовый проект для обращения не нужен.</p>
        <ContactChannels label="Связаться по поводу проекта" emailSubject="Проект автоматизации Ritmod" />
      </div>
      <div class="project-checklist">
        <h3>Для первого разговора</h3>
        <p>Начать можно с описания задачи. Остальные сведения добавьте, если они уже есть.</p>
        <ul class="project-topics" role="list">
          <li><strong>Объект</strong><span>Тип объекта и стадия работ.</span></li>
          <li><strong>План или схема</strong><span>Прикрепите, если уже есть.</span></li>
          <li><strong>Задачи</strong><span>Что должно работать автоматически.</span></li>
          <li><strong>Оборудование и сроки</strong><span>Что уже выбрано и когда нужен результат.</span></li>
        </ul>
        <p class="project-checklist-note">Поможем сформулировать задачу и определить состав автоматизации. Если уже работаете с электриком, подключите его к разговору.</p>
      </div>
    </div>
  </section>
</SiteLayout>

<style>
  .commercial-hero {
    padding-block: clamp(32px, 4vw, 56px);
  }

  .service-intro {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: center;
    gap: clamp(32px, 4vw, 64px);
  }

  .service-intro h1 {
    margin: 0;
    font-size: clamp(36px, 3.8vw, 56px);
    font-weight: 850;
    line-height: 1.05;
    letter-spacing: -0.05em;
    text-wrap: balance;
    overflow-wrap: break-word;
  }

  .service-intro h1 span {
    color: var(--accent-dark);
  }

  .service-copy .hero-lede {
    margin-top: 24px;
  }

  .service-actions {
    gap: 12px;
    margin-top: 24px;
  }

  .service-actions .button {
    font-size: 13px;
  }

  .service-software-link {
    flex-basis: 100%;
    min-height: 44px;
  }

  @media (min-width: 851px) {
    .commercial-hero {
      padding-block: clamp(20px, 4vh, 56px);
    }
  }

  @media (min-width: 851px) and (max-height: 650px) {
    .service-intro h1 {
      font-size: clamp(36px, 3.4vw, 48px);
    }

    .service-copy .eyebrow {
      margin-bottom: 16px;
    }

    .service-copy .hero-lede {
      margin-top: 16px;
      margin-bottom: 12px;
    }

    .service-actions {
      margin-top: 16px;
    }
  }

  @media (max-width: 850px) {
    .service-intro {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  #result {
    --muted: #c8c8bd;
    --line: #ffffff36;
  }

  .project-tasks {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 32px;
    margin-top: 40px;
  }

  .project-tasks article {
    min-width: 0;
    padding-top: 24px;
    border-top: 1px solid var(--line);
  }

  .project-tasks h3 {
    margin: 0 0 12px;
    font-size: 24px;
    letter-spacing: -0.03em;
  }

  .project-tasks p {
    margin: 0;
    color: var(--muted);
    font-size: 16px;
    line-height: 1.6;
  }

  @media (max-width: 850px) {
    .project-tasks {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 650px) {
    .project-tasks {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
